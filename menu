    sed -i '/net.core.wmem_max/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_rmem/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_wmem/d' /etc/sysctl.conf
    sed -i '/net.ipv4.udp_rmem_min/d' /etc/sysctl.conf
    sed -i '/net.ipv4.udp_wmem_min/d' /etc/sysctl.conf
    sed -i '/net.core.netdev_max_backlog/d' /etc/sysctl.conf
    sed -i '/net.core.somaxconn/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_max_syn_backlog/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_tw_reuse/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_fin_timeout/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_keepalive_time/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_keepalive_intvl/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_keepalive_probes/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_max_tw_buckets/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_mtu_probing/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_timestamps/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_sack/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_window_scaling/d' /etc/sysctl.conf
    sed -i '/net.core.optmem_max/d' /etc/sysctl.conf
    sed -i '/net.ipv4.ip_local_port_range/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_ecn/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_rfc1337/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_synack_retries/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_syn_retries/d' /etc/sysctl.conf
    sed -i '/net.core.netdev_budget/d' /etc/sysctl.conf
    sed -i '/net.core.netdev_budget_usecs/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_notsent_lowat/d' /etc/sysctl.conf
    sed -i '/net.ipv4.route.min_pmtu/d' /etc/sysctl.conf
    sed -i '/net.ipv4.route.mtu_expires/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_base_mss/d' /etc/sysctl.conf

    cat >> /etc/sysctl.conf << 'EOF'

# IPv4/IPv6 Dual-Stack Gaming Optimizations (v3.2)
# --- Fast session setup and low-latency TCP behavior ---
net.ipv4.tcp_fastopen=3
net.ipv4.tcp_slow_start_after_idle=0
net.ipv4.tcp_no_metrics_save=1
net.ipv4.tcp_notsent_lowat=16384

# --- Moderate buffer sizes to reduce jitter while preserving throughput ---
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 65536 16777216
net.ipv4.udp_rmem_min=16384
net.ipv4.udp_wmem_min=16384
net.core.optmem_max=65536

# --- Queue depth and scheduler budget ---
net.core.netdev_max_backlog=32768
net.core.somaxconn=32768
net.ipv4.tcp_max_syn_backlog=32768
net.core.netdev_budget=600
net.core.netdev_budget_usecs=6000

# --- Connection lifecycle tuning ---
net.ipv4.tcp_tw_reuse=1
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_max_tw_buckets=1000000
net.ipv4.tcp_keepalive_time=120
net.ipv4.tcp_keepalive_intvl=10
net.ipv4.tcp_keepalive_probes=9

# --- MTU and mobile-network resilience ---
net.ipv4.tcp_mtu_probing=1
net.ipv4.route.min_pmtu=1200
net.ipv4.route.mtu_expires=600
net.ipv4.tcp_base_mss=1024

# --- Robustness and compatibility ---
net.ipv4.tcp_timestamps=1
net.ipv4.tcp_sack=1
net.ipv4.tcp_window_scaling=1
net.ipv4.ip_local_port_range=1024 65535
net.ipv4.tcp_ecn=0
net.ipv4.tcp_rfc1337=1
net.ipv4.tcp_synack_retries=2
net.ipv4.tcp_syn_retries=2
EOF

    sysctl -p > /dev/null 2>&1
    print_success "Dual-stack network optimizations applied"
}

increase_file_limits() {
    print_info "Increasing file descriptor limits..."

    # Remove existing entries to avoid duplicates
    sed -i '/soft nofile/d' /etc/security/limits.conf
    sed -i '/hard nofile/d' /etc/security/limits.conf
    sed -i '/soft nproc/d' /etc/security/limits.conf
    sed -i '/hard nproc/d' /etc/security/limits.conf

    cat >> /etc/security/limits.conf << 'EOF'
* soft nofile 1048576
* hard nofile 1048576
* soft nproc 1048576
* hard nproc 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF

    ulimit -n 1048576 2>/dev/null
    print_success "File descriptor limits increased to 1048576"
}

optimize_irq_affinity() {
    print_info "Optimizing IRQ affinity for network interfaces..."

    # Install irqbalance if not present
    if ! command -v irqbalance &> /dev/null; then
        apt install -y irqbalance > /dev/null 2>&1
    fi

    systemctl enable irqbalance > /dev/null 2>&1
    systemctl start irqbalance > /dev/null 2>&1
    print_success "IRQ balancing enabled"
}

optimize_mtu() {
    print_info "Applying MTU and MSS tuning for mobile-network stability..."

    local iface=$(ip route show default | awk '/default/ {print $5}' | head -n 1)
    if [[ -z "$iface" ]]; then
        iface=$(ip -6 route show default | awk '/default/ {print $5}' | head -n 1)
    fi

    if [[ -z "$iface" ]]; then
        print_warning "Could not detect default network interface"
        return 1
    fi

    local current_mtu=$(ip link show "$iface" | awk '/mtu/ {print $5}')
    local recommended_mtu=1400
    local recommended_mss=1360

    print_info "Interface: $iface, Current MTU: $current_mtu"

    if [[ "$current_mtu" -lt 1280 ]]; then
        ip link set "$iface" mtu 1280 2>/dev/null
        print_warning "MTU was below IPv6 minimum (1280), adjusted"
    fi

    if tc qdisc replace dev "$iface" root fq 2>/dev/null; then
        print_success "Applied fq qdisc on $iface to complement BBR"
    elif tc qdisc replace dev "$iface" root fq_codel 2>/dev/null; then
        print_success "Applied fq_codel qdisc on $iface as low-latency fallback"
    else
        print_warning "Could not change live qdisc on $iface; default qdisc from sysctl will still apply"
    fi

    if command -v iptables &> /dev/null; then
        iptables -t mangle -C OUTPUT -p tcp --sport 443 --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$recommended_mss" 2>/dev/null ||             iptables -t mangle -A OUTPUT -p tcp --sport 443 --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$recommended_mss" 2>/dev/null
        iptables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null ||             iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
    fi

    if command -v ip6tables &> /dev/null; then
        ip6tables -t mangle -C OUTPUT -p tcp --sport 443 --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$recommended_mss" 2>/dev/null ||             ip6tables -t mangle -A OUTPUT -p tcp --sport 443 --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$recommended_mss" 2>/dev/null
        ip6tables -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null ||             ip6tables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
    fi

    cat > "$CONFIG_DIR/mobile-network-profile.conf" << EOF
# Mobile-friendly VPN profile generated by VPN Gaming Autoscript v$SCRIPT_VERSION
INTERFACE=$iface
RECOMMENDED_MTU=$recommended_mtu
RECOMMENDED_TCP_MSS=$recommended_mss
EOF

    print_success "MTU optimization applied (recommended MTU=$recommended_mtu, TCP MSS=$recommended_mss)"
}

setup_tcp_tuned_profile() {
    print_info "Setting up optimized TCP profile..."

    # Enable NIC offloading on default interface
    local iface=$(ip route show default | awk '/default/ {print $5}' | head -n 1)
    if [[ -n "$iface" ]]; then
