    echo -e " ${CYAN} 9.${NC} IPv6 Diagnostics & Status"
    echo -e " ${CYAN}10.${NC} Uninstall"
    echo -e " ${CYAN} 0.${NC} Exit"
    echo ""

    # Show service status
    if systemctl is-active --quiet trojan; then
        echo -e "${GREEN}[✓]${NC} Trojan: Running (Dual-Stack)"
    fi
    if systemctl is-active --quiet xray; then
        echo -e "${GREEN}[✓]${NC} Xray: Running (Dual-Stack)"
    fi

    # Count additional instances
    TROJAN_COUNT=0
    for service in /etc/systemd/system/trojan-*.service; do
        if [[ -f "$service" ]] && systemctl is-active --quiet "$(basename "$service" .service)"; then
            ((TROJAN_COUNT++))
        fi
    done
    if [[ $TROJAN_COUNT -gt 0 ]]; then
        echo -e "${GREEN}[✓]${NC} Trojan Additional IPs: $TROJAN_COUNT"
    fi

    XRAY_COUNT=0
    for service in /etc/systemd/system/xray-*.service; do
        if [[ -f "$service" ]] && systemctl is-active --quiet "$(basename "$service" .service)"; then
            ((XRAY_COUNT++))
        fi
    done
    if [[ $XRAY_COUNT -gt 0 ]]; then
        echo -e "${GREEN}[✓]${NC} Xray Additional IPs: $XRAY_COUNT"
    fi

    # Show IP stack summary
    local pub4=$(get_main_ip)
    local pub6=$(get_main_ipv6)
    echo ""
    echo -e "${BLUE}Server IPv4:${NC} $pub4"
    if [[ -n "$pub6" ]]; then
        echo -e "${BLUE}Server IPv6:${NC} $pub6"
    else
        echo -e "${BLUE}Server IPv6:${NC} ${YELLOW}Not available${NC}"
    fi

    echo ""
}

main() {
    # Initial setup
    mkdir -p "$INSTALL_DIR"
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$CLIENT_DIR"
    touch "$LOG_FILE"

    # Check requirements
    check_root
    check_os
    check_internet

    # Main loop
    while true; do
        show_menu
        print_prompt "Enter your choice (0-10):"
        read -r CHOICE

        case $CHOICE in
            1) install_trojan ;;
            2) install_xray ;;
            3) add_trojan_on_ip ;;
            4) add_xray_on_ip ;;
            5) switch_protocol ;;
            6) view_connection_info ;;
            7) optimize_for_gaming ;;
            8) speed_test ;;
            9) ipv6_diagnostics ;;
            10) uninstall_vpn ;;
            0)
                clear
                print_success "Thank you for using VPN Gaming Autoscript v$SCRIPT_VERSION (Dual-Stack)!"
                exit 0
                ;;
            *)
                print_error "Invalid choice. Please try again."
                sleep 2
                ;;
        esac
    done
}

# Run main function
main
