###############################################################################
# Xray on Additional IP (Dual-Stack)
###############################################################################

add_xray_on_ip() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Add Xray on Additional IP (Dual-Stack)      ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Check if main Xray is installed
    if ! systemctl is-active --quiet xray; then
        print_error "Main Xray service is not installed"
        print_info "Please install Xray first (option 2)"
        read -p "Press Enter to continue..."
        return 1
    fi

    # Show available IPs (IPv4 + IPv6)
    print_info "Detecting server IP addresses (IPv4 + IPv6)..."
    echo ""
    mapfile -t IPV4S < <(get_all_ips)
    mapfile -t IPV6S < <(get_all_ipv6)

    local ALL_IPS=()
    local idx=1

    echo -e "${CYAN}Available IPv4 addresses:${NC}"
    for ip in "${IPV4S[@]}"; do
        echo "  $idx. $ip"
        ALL_IPS+=("$ip")
        ((idx++))
    done

    if [[ ${#IPV6S[@]} -gt 0 ]]; then
        echo ""
        echo -e "${CYAN}Available IPv6 addresses:${NC}"
        for ip in "${IPV6S[@]}"; do
            echo "  $idx. $ip"
            ALL_IPS+=("$ip")
            ((idx++))
        done
    fi

    echo "  $idx. Enter custom IP (IPv4 or IPv6)"
    echo ""

    print_prompt "Select IP address (1-$idx):"
    read -r IP_CHOICE

    if [[ $IP_CHOICE -eq $idx ]]; then
        print_prompt "Enter IP address (IPv4 or IPv6):"
        read -r ADDITIONAL_IP
    elif [[ $IP_CHOICE -ge 1 ]] && [[ $IP_CHOICE -lt $idx ]]; then
        ADDITIONAL_IP="${ALL_IPS[$((IP_CHOICE-1))]}"
    else
        print_error "Invalid choice"
        read -p "Press Enter to continue..."
        return 1
    fi

    print_info "Using IP: $ADDITIONAL_IP"

    # Generate unique identifier for this instance
    IP_SUFFIX=$(format_ip_suffix "$ADDITIONAL_IP")
    SERVICE_NAME="xray-$IP_SUFFIX"
    CONFIG_FILE="/usr/local/etc/xray/config-$IP_SUFFIX.json"

    # Check if already exists
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        print_warning "Xray is already running on $ADDITIONAL_IP"
        read -p "Press Enter to continue..."
        return 0
    fi

    # Generate new parameters
    NEW_UUID=$(generate_uuid)

    # Generate X25519 keys
    KEYS=$(/usr/local/bin/xray x25519 2>&1)
    if [[ $? -ne 0 ]]; then
        print_error "Failed to generate X25519 keys"
        read -p "Press Enter to continue..."
        return 1
    fi

    PRIVATE_KEY=$(echo "$KEYS" | grep -iE "Private" | awk '{print $2}')
    PUBLIC_KEY=$(echo "$KEYS" | grep -iE "Public|Password" | awk '{print $2}')
    SHORT_ID=$(generate_short_id 8)

    # Validate keys
    if [[ -z "$PRIVATE_KEY" ]] || [[ -z "$PUBLIC_KEY" ]]; then
        print_error "Failed to extract keys"
        read -p "Press Enter to continue..."
        return 1
    fi

    # Get camouflage from main config
    CAMOUFLAGE=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' /usr/local/etc/xray/config.json)

    print_info "Creating configuration for $ADDITIONAL_IP..."

    # Create new config (bind to specific IP)
    cat > "$CONFIG_FILE" << EOF
{
    "log": {
        "loglevel": "warning"
    },
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {
                "type": "field",
                "domain": [
                    "geosite:category-ads-all"
                ],
                "outboundTag": "block"
            }
        ]
    },
    "inbounds": [
        {
            "listen": "$ADDITIONAL_IP",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "id": "$NEW_UUID",
                        "flow": "xtls-rprx-vision"
                    }
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "$CAMOUFLAGE:443",
                    "xver": 0,
                    "serverNames": [
                        "$CAMOUFLAGE"
                    ],
                    "privateKey": "$PRIVATE_KEY",
                    "minClientVer": "",
                    "maxClientVer": "",
                    "maxTimeDiff": 0,
                    "shortIds": [
                        "$SHORT_ID"
                    ]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct",
            "settings": {
                "domainStrategy": "UseIPv4v6"
            }
        },
        {
            "protocol": "blackhole",
            "tag": "block"
        }
    ],
    "policy": {
        "levels": {
            "0": {
                "handshake": 3,
                "connIdle": 180,
                "uplinkOnly": 2,
                "downlinkOnly": 5,
                "bufferSize": 64
            }
        }
    }
}
EOF

    print_success "Configuration created"

    # Create systemd service
    print_info "Creating systemd service..."

    cat > "/etc/systemd/system/$SERVICE_NAME.service" << EOF
[Unit]
Description=Xray XTLS-Reality Server on $ADDITIONAL_IP (Dual-Stack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/xray run -c $CONFIG_FILE
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "$SERVICE_NAME" > /dev/null 2>&1
    systemctl start "$SERVICE_NAME"

    if systemctl is-active --quiet "$SERVICE_NAME"; then
        print_success "Xray service started on $ADDITIONAL_IP"
    else
        print_error "Failed to start Xray service"
        journalctl -u "$SERVICE_NAME" -n 20
        read -p "Press Enter to continue..."
        return 1
    fi

    # Save credentials
    local URL_HOST=$(format_ip_for_url "$ADDITIONAL_IP")
    cat > "$CLIENT_DIR/xray-$IP_SUFFIX-credentials.txt" << EOF
Xray XTLS-Reality Server Information (Dual-Stack)
===================================================
Server: $ADDITIONAL_IP
Port: 443
UUID: $NEW_UUID
Public Key: $PUBLIC_KEY
Short ID: $SHORT_ID
SNI: $CAMOUFLAGE
Flow: xtls-rprx-vision
Security: reality

Connection URI:
vless://$NEW_UUID@$URL_HOST:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$CAMOUFLAGE&fp=chrome&pbk=$PUBLIC_KEY&sid=$SHORT_ID&type=tcp#Xray-$IP_SUFFIX
EOF

    # Generate QR code
    qrencode -t ANSIUTF8 "vless://$NEW_UUID@$URL_HOST:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$CAMOUFLAGE&fp=chrome&pbk=$PUBLIC_KEY&sid=$SHORT_ID&type=tcp#Xray-$IP_SUFFIX" > "$CLIENT_DIR/xray-$IP_SUFFIX-qr.txt" 2>/dev/null

    # Display information
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Xray Added on Additional IP! (Dual-Stack)   ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}Server:${NC} $ADDITIONAL_IP"
    echo -e "${CYAN}Port:${NC} 443"
    echo -e "${CYAN}UUID:${NC} $NEW_UUID"
    echo -e "${CYAN}Public Key:${NC} $PUBLIC_KEY"
    echo -e "${CYAN}Short ID:${NC} $SHORT_ID"
    echo ""
    echo -e "${YELLOW}Connection URI:${NC}"
    echo "vless://$NEW_UUID@$URL_HOST:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$CAMOUFLAGE&fp=chrome&pbk=$PUBLIC_KEY&sid=$SHORT_ID&type=tcp#Xray-$IP_SUFFIX"
    echo ""
    if [[ -f "$CLIENT_DIR/xray-$IP_SUFFIX-qr.txt" ]]; then
        cat "$CLIENT_DIR/xray-$IP_SUFFIX-qr.txt"
