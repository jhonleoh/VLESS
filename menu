ensure_trojan_go() {
    if [[ -x /usr/local/bin/trojan-go ]]; then
        print_success "Trojan-Go already installed"
        return 0
    fi

    print_info "Downloading Trojan-Go..."
    local tg_version=$(curl -s https://api.github.com/repos/p4gefau1t/trojan-go/releases/latest | jq -r '.tag_name' | sed 's/^v//')
    local tg_url="https://github.com/p4gefau1t/trojan-go/releases/download/v${tg_version}/trojan-go-linux-amd64.zip"

    cd /tmp || return 1
    rm -rf trojan-go-download
    mkdir -p trojan-go-download
    cd trojan-go-download || return 1
    wget -q "$tg_url" -O trojan-go.zip
    unzip -oq trojan-go.zip

    install -m 755 trojan-go /usr/local/bin/trojan-go
    mkdir -p /usr/local/etc/trojan-go

    if [[ -f geoip.dat ]]; then
        cp geoip.dat /usr/local/etc/trojan-go/geoip.dat
    fi
    if [[ -f geosite.dat ]]; then
        cp geosite.dat /usr/local/etc/trojan-go/geosite.dat
    fi

    rm -rf /tmp/trojan-go-download
    print_success "Trojan-Go installed"
