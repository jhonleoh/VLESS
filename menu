#!/bin/bash

###############################################################################
# Auto-Install to PATH
###############################################################################

# Check if script is in PATH
SCRIPT_NAME="menu"
SCRIPT_PATH="$(readlink -f "$0")"
INSTALL_PATH="/usr/local/bin/$SCRIPT_NAME"

# If not running from /usr/local/bin, offer to install
if [[ "$SCRIPT_PATH" != "$INSTALL_PATH" ]] && [[ ! -L "$INSTALL_PATH" ]]; then
    # Check if running as root
    if [[ $EUID -eq 0 ]]; then
        echo "[i] Installing 'menu' command to system PATH..."
        cp "$SCRIPT_PATH" "$INSTALL_PATH"
        chmod +x "$INSTALL_PATH"
        echo "[✓] Installation complete!"
        echo "[i] You can now type 'menu' from anywhere!"
        echo ""
        sleep 2
        # Re-execute from installed location
        exec "$INSTALL_PATH" "$@"
    else
        echo "[!] First-time setup: Installing 'menu' command..."
        echo "[i] This requires root privileges"
        echo ""
        if command -v sudo &> /dev/null; then
            sudo cp "$SCRIPT_PATH" "$INSTALL_PATH"
            sudo chmod +x "$INSTALL_PATH"
            echo "[✓] Installation complete!"
            echo "[i] You can now type 'menu' from anywhere!"
            echo ""
            sleep 2
            # Re-execute from installed location with sudo
            exec sudo "$INSTALL_PATH" "$@"
        else
            echo "[!] sudo not available. Please run as root:"
            echo "    su -"
            echo "    bash $SCRIPT_PATH"
            exit 1
        fi
    fi
fi

# If not root, re-execute with sudo
if [[ $EUID -ne 0 ]]; then
    if command -v sudo &> /dev/null; then
        exec sudo "$0" "$@"
    else
        echo "[!] This script requires root privileges"
        echo "[!] Please run: su - or install sudo"
        exit 1
    fi
fi

###############################################################################
# VPN Gaming Autoscript v3.0 - All-in-One Edition (IPv4/IPv6 Dual-Stack)
# Optimized TLS-based VPN installation for low-ping gaming
# Supports: Trojan-GFW and Xray XTLS-Reality
# OS: Debian 10/11/12/13, Ubuntu 20.04/22.04/24.04
# NEW: Full IPv6 dual-stack support, speed parity, advanced optimizations
###############################################################################

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Global variables
SCRIPT_VERSION="3.0"
INSTALL_DIR="/opt/vpn-gaming"
CONFIG_DIR="/etc/vpn-gaming"
LOG_FILE="/var/log/vpn-gaming-install.log"
CLIENT_DIR="$HOME/vpn-clients"

###############################################################################
# Utility Functions
###############################################################################

print_success() {
    echo -e "${GREEN}[✓]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] SUCCESS: $1" >> "$LOG_FILE"
}

print_error() {
    echo -e "${RED}[✗]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1" >> "$LOG_FILE"
}

print_warning() {
    echo -e "${YELLOW}[!]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARNING: $1" >> "$LOG_FILE"
}

print_info() {
    echo -e "${BLUE}[i]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] INFO: $1" >> "$LOG_FILE"
}

print_prompt() {
    echo -e "${CYAN}[?]${NC} $1"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        print_error "This script must be run as root"
        exit 1
    fi
}

check_os() {
    if [[ -f /etc/os-release ]]; then
        . /etc/os-release
        OS=$ID
        VER=$VERSION_ID
        
        if [[ "$OS" == "debian" ]] || [[ "$OS" == "ubuntu" ]]; then
            print_success "Detected $OS $VER"
            return 0
        else
            print_error "Unsupported OS: $OS"
            print_info "This script only supports Debian and Ubuntu"
            exit 1
        fi
    else
        print_error "Cannot detect OS"
        exit 1
    fi
}

check_internet() {
    print_info "Checking internet connectivity (IPv4 + IPv6)..."
    local ipv4_ok=false
    local ipv6_ok=false

    # Check IPv4 connectivity
    if ping -4 -c 1 -W 5 8.8.8.8 &> /dev/null; then
        ipv4_ok=true
        print_success "IPv4 connectivity: OK"
    else
        print_warning "IPv4 connectivity: FAILED"
    fi

    # Check IPv6 connectivity
    if ping -6 -c 1 -W 5 2001:4860:4860::8888 &> /dev/null; then
        ipv6_ok=true
        print_success "IPv6 connectivity: OK"
    else
        print_warning "IPv6 connectivity: Not available (IPv4-only mode)"
    fi

    if [[ "$ipv4_ok" == false ]] && [[ "$ipv6_ok" == false ]]; then
        print_error "No internet connection (neither IPv4 nor IPv6)"
        exit 1
    fi

    # Store global connectivity flags
    HAS_IPV4=$ipv4_ok
    HAS_IPV6=$ipv6_ok
    return 0
}

generate_random_password() {
    tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32
}

generate_uuid() {
    cat /proc/sys/kernel/random/uuid
}

generate_short_id() {
    tr -dc 'a-f0-9' < /dev/urandom | head -c ${1:-8}
}

###############################################################################
# IPv4/IPv6 Dual-Stack IP Detection Functions
###############################################################################

get_all_ips() {
    # Get all IPv4 addresses on the server
    ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1'
}

get_all_ipv6() {
    # Get all global-scope IPv6 addresses on the server (exclude link-local fe80::)
    ip -6 addr show scope global | grep -oP '(?<=inet6\s)[0-9a-f:]+' | grep -v '^::1$'
}

get_all_dual_stack_ips() {
    # Get all IPv4 and IPv6 addresses combined
    echo "--- IPv4 Addresses ---"
    get_all_ips
    echo "--- IPv6 Addresses ---"
    get_all_ipv6
}

get_main_ip() {
    # Get the main public IPv4 with multiple fallbacks
    local ip

    # Try multiple services with timeout
    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 ipinfo.io/ip 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 api.ipify.org 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    # Fallback: get first non-localhost IP from server
    ip=$(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -n 1)
    if [[ -n "$ip" ]]; then
        echo "$ip"
        return 0
    fi

    # Last resort
    echo "127.0.0.1"
}

get_main_ipv6() {
    # Get the main public IPv6 with multiple fallbacks
    local ip6

    ip6=$(curl -6 -s --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null)
    if [[ -n "$ip6" ]] && [[ "$ip6" =~ : ]]; then
        echo "$ip6"
        return 0
    fi

    ip6=$(curl -6 -s --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
    if [[ -n "$ip6" ]] && [[ "$ip6" =~ : ]]; then
        echo "$ip6"
        return 0
    fi

    ip6=$(curl -6 -s --connect-timeout 5 --max-time 10 api64.ipify.org 2>/dev/null)
    if [[ -n "$ip6" ]] && [[ "$ip6" =~ : ]]; then
        echo "$ip6"
        return 0
    fi

    # Fallback: get first global IPv6 from server interfaces
    ip6=$(ip -6 addr show scope global | grep -oP '(?<=inet6\s)[0-9a-f:]+' | head -n 1)
    if [[ -n "$ip6" ]]; then
        echo "$ip6"
        return 0
    fi

    echo ""
}

is_ipv6() {
    # Check if a given string is an IPv6 address
    [[ "$1" =~ : ]]
}

format_ip_for_url() {
    # Wrap IPv6 in brackets for URLs, leave IPv4 as-is
    if is_ipv6 "$1"; then
        echo "[$1]"
    else
        echo "$1"
    fi
}

format_ip_suffix() {
    # Create a safe suffix from IP (replace dots and colons with dashes)
    echo "$1" | tr '.:' '--'
}

detect_ip_stack() {
    # Detect and display the server's IP stack capabilities
    local ipv4=$(get_main_ip)
    local ipv6=$(get_main_ipv6)

    echo ""
    echo -e "${CYAN}=== Server IP Stack Detection ===${NC}"
    if [[ -n "$ipv4" ]] && [[ "$ipv4" != "127.0.0.1" ]]; then
        echo -e "  ${GREEN}[✓]${NC} IPv4: $ipv4"
    else
        echo -e "  ${RED}[✗]${NC} IPv4: Not detected"
    fi

    if [[ -n "$ipv6" ]]; then
        echo -e "  ${GREEN}[✓]${NC} IPv6: $ipv6"
    else
        echo -e "  ${YELLOW}[!]${NC} IPv6: Not detected (IPv4-only server)"
    fi
    echo ""
}

###############################################################################
# System Optimization Functions (Dual-Stack IPv4/IPv6)
###############################################################################

enable_bbr() {
    print_info "Enabling TCP BBR congestion control..."

    # Check if BBR is already enabled
    if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr; then
        print_success "TCP BBR already enabled"
        return 0
    fi

    # Check kernel version (BBR requires 4.9+)
    kernel_version=$(uname -r | cut -d. -f1)
    if [[ $kernel_version -lt 4 ]]; then
        print_warning "Kernel version too old for BBR (requires 4.9+)"
        return 1
    fi

    # Remove any existing BBR/qdisc entries to avoid duplicates
    sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf

    # Enable BBR
    echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
    echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
    sysctl -p > /dev/null 2>&1

    # Verify
    if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr; then
        print_success "TCP BBR enabled successfully"
    else
        print_error "Failed to enable TCP BBR"
        return 1
    fi
}

enable_ipv6_forwarding() {
    print_info "Enabling IPv6 forwarding and dual-stack support..."

    # Remove existing entries to avoid duplicates
    sed -i '/net.ipv6.conf.all.forwarding/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.default.forwarding/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.all.accept_ra/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.default.accept_ra/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.all.disable_ipv6/d' /etc/sysctl.conf

    cat >> /etc/sysctl.conf << 'EOF'

# IPv6 Dual-Stack Forwarding
net.ipv6.conf.all.forwarding=1
net.ipv6.conf.default.forwarding=1
net.ipv6.conf.all.accept_ra=2
net.ipv6.conf.default.accept_ra=2
net.ipv6.conf.all.disable_ipv6=0
EOF

    sysctl -p > /dev/null 2>&1
    print_success "IPv6 forwarding enabled"
}

optimize_network() {
    print_info "Applying dual-stack network optimizations for gaming..."

    # Remove existing gaming optimization entries to avoid duplicates
    sed -i '/# Gaming optimizations/d' /etc/sysctl.conf
    sed -i '/# IPv4\/IPv6 Dual-Stack Gaming Optimizations/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_fastopen/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_slow_start_after_idle/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_no_metrics_save/d' /etc/sysctl.conf
    sed -i '/net.core.rmem_max/d' /etc/sysctl.conf
    sed -i '/net.core.wmem_max/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_rmem/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_wmem/d' /etc/sysctl.conf
    sed -i '/net.ipv4.udp_rmem_min/d' /etc/sysctl.conf
    sed -i '/net.ipv4.udp_wmem_min/d' /etc/sysctl.conf
    sed -i '/net.core.netdev_max_backlog/d' /etc/sysctl.conf
    sed -i '/net.core.somaxconn/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_max_syn_backlog/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_tw_reuse/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_fin_timeout/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_keepalive_time/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_keepalive_intvl/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_keepalive_probes/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_max_tw_buckets/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_mtu_probing/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_timestamps/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_sack/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_window_scaling/d' /etc/sysctl.conf
    sed -i '/net.core.optmem_max/d' /etc/sysctl.conf
    sed -i '/net.ipv4.ip_local_port_range/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_ecn/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_rfc1337/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_synack_retries/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_syn_retries/d' /etc/sysctl.conf
    sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf

    cat >> /etc/sysctl.conf << 'EOF'

# IPv4/IPv6 Dual-Stack Gaming Optimizations (v3.0)
# --- BBR Congestion Control ---
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr

# --- TCP Fast Open (works for both IPv4 and IPv6) ---
net.ipv4.tcp_fastopen=3

# --- Disable slow start after idle (reduces latency spikes) ---
net.ipv4.tcp_slow_start_after_idle=0

# --- Don't cache TCP metrics from previous connections ---
net.ipv4.tcp_no_metrics_save=1

# --- Enlarged socket buffers for high throughput (IPv4+IPv6 shared) ---
net.core.rmem_max=67108864
net.core.wmem_max=67108864
net.ipv4.tcp_rmem=4096 87380 67108864
net.ipv4.tcp_wmem=4096 65536 67108864
net.ipv4.udp_rmem_min=8192
net.ipv4.udp_wmem_min=8192
net.core.optmem_max=65536

# --- Connection backlog and queue depth ---
net.core.netdev_max_backlog=65536
net.core.somaxconn=65535
net.ipv4.tcp_max_syn_backlog=65536

# --- Connection reuse and recycling ---
net.ipv4.tcp_tw_reuse=1
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_max_tw_buckets=2000000

# --- Keepalive tuning (faster dead connection detection) ---
net.ipv4.tcp_keepalive_time=300
net.ipv4.tcp_keepalive_intvl=15
net.ipv4.tcp_keepalive_probes=5

# --- MTU probing (auto-discover optimal MTU for IPv6 tunnels) ---
net.ipv4.tcp_mtu_probing=1

# --- TCP timestamps, SACK, and window scaling ---
net.ipv4.tcp_timestamps=1
net.ipv4.tcp_sack=1
net.ipv4.tcp_window_scaling=1

# --- Widen ephemeral port range ---
net.ipv4.ip_local_port_range=1024 65535

# --- ECN and RFC1337 for robustness ---
net.ipv4.tcp_ecn=0
net.ipv4.tcp_rfc1337=1

# --- Reduce SYN retries for faster connection setup ---
net.ipv4.tcp_synack_retries=2
net.ipv4.tcp_syn_retries=2
EOF

    sysctl -p > /dev/null 2>&1
    print_success "Dual-stack network optimizations applied"
}

increase_file_limits() {
    print_info "Increasing file descriptor limits..."

    # Remove existing entries to avoid duplicates
    sed -i '/soft nofile/d' /etc/security/limits.conf
    sed -i '/hard nofile/d' /etc/security/limits.conf
    sed -i '/soft nproc/d' /etc/security/limits.conf
    sed -i '/hard nproc/d' /etc/security/limits.conf

    cat >> /etc/security/limits.conf << 'EOF'
* soft nofile 1048576
* hard nofile 1048576
* soft nproc 1048576
* hard nproc 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF

    ulimit -n 1048576 2>/dev/null
    print_success "File descriptor limits increased to 1048576"
}

optimize_irq_affinity() {
    print_info "Optimizing IRQ affinity for network interfaces..."

    # Install irqbalance if not present
    if ! command -v irqbalance &> /dev/null; then
        apt install -y irqbalance > /dev/null 2>&1
    fi

    systemctl enable irqbalance > /dev/null 2>&1
    systemctl start irqbalance > /dev/null 2>&1
    print_success "IRQ balancing enabled"
}

optimize_mtu() {
    print_info "Detecting and optimizing MTU for all interfaces..."

    # Get the default network interface
    local iface=$(ip route show default | awk '/default/ {print $5}' | head -n 1)
    if [[ -z "$iface" ]]; then
        iface=$(ip -6 route show default | awk '/default/ {print $5}' | head -n 1)
    fi

    if [[ -n "$iface" ]]; then
        local current_mtu=$(ip link show "$iface" | awk '/mtu/ {print $5}')
        print_info "Interface: $iface, Current MTU: $current_mtu"

        # For IPv6, ensure MTU is at least 1280 (IPv6 minimum)
        if [[ "$current_mtu" -lt 1280 ]]; then
            ip link set "$iface" mtu 1280
            print_warning "MTU was below IPv6 minimum (1280), adjusted"
        fi

        # Attempt MSS clamping for better compatibility
        if command -v iptables &> /dev/null; then
            iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
        fi
        if command -v ip6tables &> /dev/null; then
            ip6tables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
        fi

        print_success "MTU optimization applied (MSS clamping enabled for IPv4+IPv6)"
    else
        print_warning "Could not detect default network interface"
    fi
}

setup_tcp_tuned_profile() {
    print_info "Setting up optimized TCP profile..."

    # Disable TCP Segmentation Offload issues on some VPS
    local iface=$(ip route show default | awk '/default/ {print $5}' | head -n 1)
    if [[ -n "$iface" ]]; then
        # Enable GRO/GSO for performance
        ethtool -K "$iface" gro on 2>/dev/null
        ethtool -K "$iface" gso on 2>/dev/null
        ethtool -K "$iface" tso on 2>/dev/null
        print_success "NIC offloading optimized on $iface"
    fi
}

###############################################################################
# Trojan-GFW Installation (Dual-Stack IPv4/IPv6)
###############################################################################

install_trojan() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Trojan-GFW Installation (Dual-Stack v3.0)   ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Detect and show IP stack
    detect_ip_stack

    # Check if already installed
    if systemctl is-active --quiet trojan; then
        print_warning "Trojan is already installed and running"
        read -p "Do you want to reinstall? (y/n): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            return 0
        fi
        systemctl stop trojan
    fi

    # Get domain name
    print_prompt "Enter your domain name (or press Enter to use server IP):"
    read -r DOMAIN

    if [[ -z "$DOMAIN" ]]; then
        DOMAIN=$(get_main_ip)
        print_info "Using server IP: $DOMAIN"
        USE_CERT=false
    else
        print_info "Using domain: $DOMAIN"
        USE_CERT=true
    fi

    # Install dependencies
    print_info "Installing dependencies..."
    apt update > /dev/null 2>&1
    apt install -y nginx certbot python3-certbot-nginx curl jq qrencode xz-utils ethtool > /dev/null 2>&1
    print_success "Dependencies installed"

    # Configure Nginx (dual-stack: listen on both IPv4 and IPv6)
    if [[ "$USE_CERT" == true ]]; then
        print_info "Configuring Nginx (dual-stack)..."

        cat > /etc/nginx/sites-available/default << EOF
server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN;
    root /var/www/html;
    index index.html;

    location / {
        try_files \$uri \$uri/ =404;
    }
}
EOF

        # Create simple index page
        cat > /var/www/html/index.html << 'EOF'
<!DOCTYPE html>
<html>
<head>
    <title>Welcome</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; padding: 50px; }
        h1 { color: #333; }
    </style>
</head>
<body>
    <h1>Welcome to My Server</h1>
    <p>This is a simple web server.</p>
</body>
</html>
EOF

        systemctl restart nginx
        print_success "Nginx configured (IPv4+IPv6)"

        # Obtain SSL certificate
        print_info "Obtaining SSL certificate from Let's Encrypt..."
        print_warning "Make sure your domain points to this server IP: $(get_main_ip)"
        local ipv6_addr=$(get_main_ipv6)
        if [[ -n "$ipv6_addr" ]]; then
            print_warning "Also add AAAA record pointing to: $ipv6_addr"
        fi
        read -p "Press Enter to continue..."

        certbot certonly --nginx -d "$DOMAIN" --non-interactive --agree-tos --register-unsafely-without-email

        if [[ $? -eq 0 ]]; then
            print_success "SSL certificate obtained"
            chmod +rx /etc/letsencrypt/live
            chmod +rx /etc/letsencrypt/archive
            chmod -R +r /etc/letsencrypt/archive/"$DOMAIN"
        else
            print_error "Failed to obtain SSL certificate"
            print_info "Falling back to IP-based installation"
            USE_CERT=false
            DOMAIN=$(get_main_ip)
        fi
    fi

    # Download and install Trojan
    print_info "Downloading Trojan..."

    TROJAN_VERSION=$(curl -s https://api.github.com/repos/trojan-gfw/trojan/releases/latest | jq -r '.tag_name' | sed 's/v//')
    TROJAN_URL="https://github.com/trojan-gfw/trojan/releases/download/v${TROJAN_VERSION}/trojan-${TROJAN_VERSION}-linux-amd64.tar.xz"

    cd /tmp
    wget -q "$TROJAN_URL" -O trojan.tar.xz
    tar -xf trojan.tar.xz

    mkdir -p /usr/local/bin
    mkdir -p /usr/local/etc/trojan

    cp trojan/trojan /usr/local/bin/
    chmod +x /usr/local/bin/trojan

    rm -rf trojan trojan.tar.xz

    print_success "Trojan binary installed"

    # Generate password
    TROJAN_PASSWORD=$(generate_random_password)

