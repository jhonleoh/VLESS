###############################################################################
# Trojan on Additional IP (Dual-Stack)
###############################################################################

add_trojan_on_ip() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Add Trojan on Additional IP (Dual-Stack)    ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Check if main Trojan is installed
    if ! systemctl is-active --quiet trojan; then
        print_error "Main Trojan service is not installed"
        print_info "Please install Trojan first (option 1)"
        read -p "Press Enter to continue..."
        return 1
    fi

    # Show available IPs (IPv4 + IPv6)
    print_info "Detecting server IP addresses (IPv4 + IPv6)..."
    echo ""
    mapfile -t IPV4S < <(get_all_ips)
    mapfile -t IPV6S < <(get_all_ipv6)

    local ALL_IPS=()
    local idx=1

    echo -e "${CYAN}Available IPv4 addresses:${NC}"
    for ip in "${IPV4S[@]}"; do
        echo "  $idx. $ip"
        ALL_IPS+=("$ip")
        ((idx++))
    done

    if [[ ${#IPV6S[@]} -gt 0 ]]; then
        echo ""
        echo -e "${CYAN}Available IPv6 addresses:${NC}"
        for ip in "${IPV6S[@]}"; do
            echo "  $idx. $ip"
            ALL_IPS+=("$ip")
            ((idx++))
        done
    fi

    echo "  $idx. Enter custom IP (IPv4 or IPv6)"
    echo ""

    print_prompt "Select IP address (1-$idx):"
    read -r IP_CHOICE

    if [[ $IP_CHOICE -eq $idx ]]; then
        print_prompt "Enter IP address (IPv4 or IPv6):"
        read -r ADDITIONAL_IP
    elif [[ $IP_CHOICE -ge 1 ]] && [[ $IP_CHOICE -lt $idx ]]; then
        ADDITIONAL_IP="${ALL_IPS[$((IP_CHOICE-1))]}"
    else
        print_error "Invalid choice"
        read -p "Press Enter to continue..."
        return 1
    fi

    print_info "Using IP: $ADDITIONAL_IP"

    # Generate unique identifier for this instance
    IP_SUFFIX=$(format_ip_suffix "$ADDITIONAL_IP")
    SERVICE_NAME="trojan-$IP_SUFFIX"
    CONFIG_FILE="/usr/local/etc/trojan/config-$IP_SUFFIX.json"

    # Check if already exists
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        print_warning "Trojan is already running on $ADDITIONAL_IP"
        read -p "Press Enter to continue..."
        return 0
    fi

    # Generate new password
    NEW_PASSWORD=$(generate_random_password)

    # Copy and modify configuration
    print_info "Creating configuration for $ADDITIONAL_IP..."

    # Check if using certificates or self-signed
    if [[ -f "/usr/local/etc/trojan/config.json" ]]; then
        # Copy base config and modify
        cp /usr/local/etc/trojan/config.json "$CONFIG_FILE"

        # Update local_addr to bind to specific IP
        local bind_addr="$ADDITIONAL_IP"
        jq --arg ip "$bind_addr" '.local_addr = $ip' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

        # Update password
        jq --arg pass "$NEW_PASSWORD" '.password = [$pass]' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

        print_success "Configuration created"
    else
        print_error "Base configuration not found"
        return 1
    fi

    # Ensure firewall allows this IP
    if is_ipv6 "$ADDITIONAL_IP"; then
        ip6tables -C INPUT -d "$ADDITIONAL_IP" -p tcp --dport 443 -j ACCEPT 2>/dev/null || \
            ip6tables -A INPUT -d "$ADDITIONAL_IP" -p tcp --dport 443 -j ACCEPT
    fi

    # Create systemd service
    print_info "Creating systemd service..."

    cat > "/etc/systemd/system/$SERVICE_NAME.service" << EOF
[Unit]
Description=Trojan-GFW Server on $ADDITIONAL_IP (Dual-Stack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/trojan -c $CONFIG_FILE
ExecReload=/bin/kill -HUP \$MAINPID
Restart=always
RestartSec=3s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "$SERVICE_NAME" > /dev/null 2>&1
    systemctl start "$SERVICE_NAME"

    if systemctl is-active --quiet "$SERVICE_NAME"; then
        print_success "Trojan service started on $ADDITIONAL_IP"
    else
        print_error "Failed to start Trojan service"
        journalctl -u "$SERVICE_NAME" -n 20
        read -p "Press Enter to continue..."
        return 1
    fi

    # Save credentials
    local URL_HOST=$(format_ip_for_url "$ADDITIONAL_IP")
    cat > "$CLIENT_DIR/trojan-$IP_SUFFIX-credentials.txt" << EOF
Trojan-GFW Server Information (Dual-Stack)
============================================
Server: $ADDITIONAL_IP
Port: 443
Password: $NEW_PASSWORD
SNI: $ADDITIONAL_IP
Allow Insecure: true

Connection URI:
trojan://$NEW_PASSWORD@$URL_HOST:443#Trojan-$IP_SUFFIX
EOF

    # Generate QR code
    qrencode -t ANSIUTF8 "trojan://$NEW_PASSWORD@$URL_HOST:443#Trojan-$IP_SUFFIX" > "$CLIENT_DIR/trojan-$IP_SUFFIX-qr.txt" 2>/dev/null

    # Display information
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Trojan Added on Additional IP! (Dual-Stack) ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}Server:${NC} $ADDITIONAL_IP"
    echo -e "${CYAN}Port:${NC} 443"
    echo -e "${CYAN}Password:${NC} $NEW_PASSWORD"
    echo ""
    echo -e "${YELLOW}Connection URI:${NC}"
    echo "trojan://$NEW_PASSWORD@$URL_HOST:443#Trojan-$IP_SUFFIX"
    echo ""
    if [[ -f "$CLIENT_DIR/trojan-$IP_SUFFIX-qr.txt" ]]; then
        cat "$CLIENT_DIR/trojan-$IP_SUFFIX-qr.txt"
    fi
    echo ""
    print_info "Credentials saved to: $CLIENT_DIR/trojan-$IP_SUFFIX-credentials.txt"
    echo ""
    read -p "Press Enter to continue..."
}

###############################################################################
# Xray XTLS-Reality Installation (Universal Dual-Stack - FIXED v3.1)
# FIXES: sockopt keepalive, proper routing for IPv6 traffic, stability
###############################################################################

install_xray() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Xray XTLS-Reality Install (Universal v3.1)  ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Detect and show IP stack
    detect_ip_stack

    # Check if already installed
    local XRAY_ALREADY_PRESENT=false
    if systemctl is-active --quiet xray 2>/dev/null || [[ -x /usr/local/bin/xray ]] || [[ -f /etc/systemd/system/xray.service ]]; then
        XRAY_ALREADY_PRESENT=true
        print_warning "Xray is already installed"
        read -p "Do you want to reinstall the Xray Reality configuration? (y/n): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            return 0
        fi
    fi

    # CRITICAL: Setup dual-stack kernel and firewall BEFORE anything else
    setup_dual_stack_kernel
    setup_ipv6_firewall
    stop_conflicting_vpn_services

    # Install dependencies
    print_info "Installing dependencies..."
    apt update > /dev/null 2>&1
    apt install -y curl unzip jq qrencode xz-utils ethtool iptables-persistent > /dev/null 2>&1
    print_success "Dependencies installed"

    # Ensure Xray core is available without failing the reinstall flow unnecessarily
    local xray_install_log="/tmp/xray-install.log"
    if [[ "$XRAY_ALREADY_PRESENT" == true && -x /usr/local/bin/xray ]]; then
        print_success "Xray-core already present; refreshing configuration"
    else
        print_info "Installing Xray-core..."
        bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install -u root > "$xray_install_log" 2>&1
        local xray_install_rc=$?

        if [[ ! -x /usr/local/bin/xray ]]; then
            print_error "Failed to install Xray-core"
            if [[ -s "$xray_install_log" ]]; then
                tail -n 20 "$xray_install_log"
            fi
            read -p "Press Enter to continue..."
            return 1
        fi

        if [[ $xray_install_rc -ne 0 ]]; then
            print_warning "Installer returned code $xray_install_rc, but Xray-core is available. Continuing with configuration refresh."
        else
            print_success "Xray-core installed"
        fi
    fi

    # Generate parameters
    print_info "Generating configuration parameters..."

    UUID=$(generate_uuid)

    # Wait a moment for xray to be fully installed
    sleep 2

    # Generate X25519 keys
    if [[ ! -x /usr/local/bin/xray ]]; then
        print_error "Xray binary not found at /usr/local/bin/xray"
        read -p "Press Enter to continue..."
        return 1
    fi

    KEYS=$(/usr/local/bin/xray x25519 2>&1)
    if [[ $? -ne 0 ]]; then
        print_error "Failed to generate X25519 keys"
        print_info "Key generation output: $KEYS"
        read -p "Press Enter to continue..."
        return 1
    fi

    PRIVATE_KEY=$(echo "$KEYS" | sed -nE 's/^[[:space:]]*Private[[:space:]]*[Kk]ey:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\1/p' | head -n1)
    PUBLIC_KEY=$(echo "$KEYS" | sed -nE 's/^[[:space:]]*(Password[[:space:]]*\()?[Pp]ublic[[:space:]]*[Kk]ey\)?:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\2/p' | head -n1)
    SHORT_ID=$(generate_short_id 8)

    # Validate keys were generated
    if [[ -z "$PRIVATE_KEY" ]] || [[ -z "$PUBLIC_KEY" ]]; then
        print_error "Failed to extract keys from xray output"
        print_info "Expected formats: 'Private key: <value>' or 'PrivateKey: <value>'"
        print_info "Expected formats: 'Public key: <value>', 'PublicKey: <value>', or 'Password (PublicKey): <value>'"
        print_info "Keys output: $KEYS"
        read -p "Press Enter to continue..."
        return 1
    fi

    print_success "UUID: $UUID"
    print_success "Public Key: $PUBLIC_KEY"
    print_success "Short ID: $SHORT_ID"

