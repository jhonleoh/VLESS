# Protocol Switching
###############################################################################

switch_protocol() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Switch Protocol (Main IP) - Universal       ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Check current status
    TROJAN_RUNNING=$(systemctl is-active trojan 2>/dev/null)
    XRAY_RUNNING=$(systemctl is-active xray 2>/dev/null)

    echo -e "${CYAN}Current Status:${NC}"
    if [[ "$TROJAN_RUNNING" == "active" ]]; then
        echo -e "  ${GREEN}[✓]${NC} Trojan: Running"
    else
        echo -e "  ${RED}[✗]${NC} Trojan: Stopped"
    fi

    if [[ "$XRAY_RUNNING" == "active" ]]; then
        echo -e "  ${GREEN}[✓]${NC} Xray: Running"
    else
        echo -e "  ${RED}[✗]${NC} Xray: Stopped"
    fi
    echo ""

    # Check if both are installed
    TROJAN_INSTALLED=false
    XRAY_INSTALLED=false

    if [[ -f /usr/local/bin/trojan ]] && [[ -f /usr/local/etc/trojan/config.json ]]; then
        TROJAN_INSTALLED=true
    fi

    if [[ -f /usr/local/bin/xray ]] && [[ -f /usr/local/etc/xray/config.json ]]; then
        XRAY_INSTALLED=true
    fi

    # Provide options based on what's installed
    if [[ "$TROJAN_INSTALLED" == false ]] && [[ "$XRAY_INSTALLED" == false ]]; then
        print_error "No protocols are installed yet"
        print_info "Please install Trojan (option 1) or Xray (option 3) first"
        echo ""
        read -p "Press Enter to continue..."
        return 0
    fi

    echo -e "${YELLOW}Switch Options:${NC}"
    echo ""

    if [[ "$TROJAN_RUNNING" == "active" ]]; then
        if [[ "$XRAY_INSTALLED" == true ]]; then
            echo -e "${CYAN}1.${NC} Switch to Xray (stop Trojan, start Xray)"
        else
            echo -e "${CYAN}1.${NC} Install and switch to Xray"
        fi
        echo -e "${CYAN}2.${NC} Stop Trojan (no VPN running)"
    elif [[ "$XRAY_RUNNING" == "active" ]]; then
        if [[ "$TROJAN_INSTALLED" == true ]]; then
            echo -e "${CYAN}1.${NC} Switch to Trojan (stop Xray, start Trojan)"
        else
            echo -e "${CYAN}1.${NC} Install and switch to Trojan"
        fi
        echo -e "${CYAN}2.${NC} Stop Xray (no VPN running)"
    else
        # Neither running
        if [[ "$TROJAN_INSTALLED" == true ]]; then
            echo -e "${CYAN}1.${NC} Start Trojan"
        fi
        if [[ "$XRAY_INSTALLED" == true ]]; then
            echo -e "${CYAN}2.${NC} Start Xray"
        fi
    fi

    echo -e "${CYAN}0.${NC} Cancel"
    echo ""

    print_prompt "Enter your choice:"
    read -r SWITCH_CHOICE

    case $SWITCH_CHOICE in
        1)
            if [[ "$TROJAN_RUNNING" == "active" ]]; then
                # Switch from Trojan to Xray
                print_info "Stopping Trojan..."
                systemctl stop trojan
                print_success "Trojan stopped"

                if [[ "$XRAY_INSTALLED" == true ]]; then
                    print_info "Starting Xray..."
                    systemctl start xray
                    sleep 2

                    if systemctl is-active --quiet xray; then
                        print_success "Xray started successfully"
                        echo ""
                        print_info "Switched to Xray!"
                        echo ""

                        # Show Xray connection info
                        if [[ -f "$CLIENT_DIR/xray-credentials.txt" ]]; then
                            echo -e "${CYAN}=== Xray Connection Info ===${NC}"
                            cat "$CLIENT_DIR/xray-credentials.txt"
                        fi
                    else
                        print_error "Failed to start Xray"
                        print_warning "Starting Trojan back..."
                        systemctl start trojan
                    fi
                else
                    print_info "Xray is not installed. Installing now..."
                    install_xray
                fi

            elif [[ "$XRAY_RUNNING" == "active" ]]; then
                # Switch from Xray to Trojan
                print_info "Stopping Xray..."
                systemctl stop xray
                print_success "Xray stopped"

                if [[ "$TROJAN_INSTALLED" == true ]]; then
                    print_info "Starting Trojan..."
                    systemctl start trojan
                    sleep 2

                    if systemctl is-active --quiet trojan; then
                        print_success "Trojan started successfully"
                        echo ""
                        print_info "Switched to Trojan!"
                        echo ""

                        # Show Trojan connection info
                        if [[ -f "$CLIENT_DIR/trojan-credentials.txt" ]]; then
                            echo -e "${CYAN}=== Trojan Connection Info ===${NC}"
                            cat "$CLIENT_DIR/trojan-credentials.txt"
                        fi
                    else
                        print_error "Failed to start Trojan"
                        print_warning "Starting Xray back..."
                        systemctl start xray
                    fi
                else
                    print_info "Trojan is not installed. Installing now..."
                    install_trojan
                fi

            else
                # Neither running, start Trojan
                if [[ "$TROJAN_INSTALLED" == true ]]; then
                    print_info "Starting Trojan..."
                    systemctl start trojan
                    sleep 2

                    if systemctl is-active --quiet trojan; then
                        print_success "Trojan started"
                        if [[ -f "$CLIENT_DIR/trojan-credentials.txt" ]]; then
                            cat "$CLIENT_DIR/trojan-credentials.txt"
                        fi
                    else
                        print_error "Failed to start Trojan"
                    fi
                fi
            fi
            ;;

        2)
            if [[ "$TROJAN_RUNNING" == "active" ]]; then
                # Stop Trojan
                print_info "Stopping Trojan..."
                systemctl stop trojan
                print_success "Trojan stopped"
                print_warning "No VPN is running now"

            elif [[ "$XRAY_RUNNING" == "active" ]]; then
                # Stop Xray
                print_info "Stopping Xray..."
                systemctl stop xray
                print_success "Xray stopped"
                print_warning "No VPN is running now"

            else
                # Start Xray
                if [[ "$XRAY_INSTALLED" == true ]]; then
                    print_info "Starting Xray..."
                    systemctl start xray
                    sleep 2

                    if systemctl is-active --quiet xray; then
                        print_success "Xray started"
                        if [[ -f "$CLIENT_DIR/xray-credentials.txt" ]]; then
                            cat "$CLIENT_DIR/xray-credentials.txt"
                        fi
                    else
                        print_error "Failed to start Xray"
                    fi
                fi
            fi
            ;;

        0)
            print_info "Cancelled"
            ;;

        *)
            print_error "Invalid choice"
            ;;
    esac

    echo ""
    read -p "Press Enter to continue..."
}

