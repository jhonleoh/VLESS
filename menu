#!/bin/bash

###############################################################################
# Auto-Install to PATH
###############################################################################

# Check if script is in PATH
SCRIPT_NAME="menu"
SCRIPT_PATH="$(readlink -f "$0")"
INSTALL_PATH="/usr/local/bin/$SCRIPT_NAME"

# If not running from /usr/local/bin, offer to install
if [[ "$SCRIPT_PATH" != "$INSTALL_PATH" ]] && [[ ! -L "$INSTALL_PATH" ]]; then
    # Check if running as root
    if [[ $EUID -eq 0 ]]; then
        echo "[i] Installing 'menu' command to system PATH..."
        cp "$SCRIPT_PATH" "$INSTALL_PATH"
        chmod +x "$INSTALL_PATH"
        echo "[✓] Installation complete!"
        echo "[i] You can now type 'menu' from anywhere!"
        echo ""
        sleep 2
        # Re-execute from installed location
        exec "$INSTALL_PATH" "$@"
    else
        echo "[!] First-time setup: Installing 'menu' command..."
        echo "[i] This requires root privileges"
        echo ""
        if command -v sudo &> /dev/null; then
            sudo cp "$SCRIPT_PATH" "$INSTALL_PATH"
            sudo chmod +x "$INSTALL_PATH"
            echo "[✓] Installation complete!"
            echo "[i] You can now type 'menu' from anywhere!"
            echo ""
            sleep 2
            # Re-execute from installed location with sudo
            exec sudo "$INSTALL_PATH" "$@"
        else
            echo "[!] sudo not available. Please run as root:"
            echo "    su -"
            echo "    bash $SCRIPT_PATH"
            exit 1
        fi
    fi
fi

# If not root, re-execute with sudo
if [[ $EUID -ne 0 ]]; then
    if command -v sudo &> /dev/null; then
        exec sudo "$0" "$@"
    else
        echo "[!] This script requires root privileges"
        echo "[!] Please run: su - or install sudo"
        exit 1
    fi
fi

###############################################################################
# VPN Gaming Autoscript v3.1 - All-in-One Edition (IPv4/IPv6 Universal)
# Optimized TLS-based VPN installation for low-ping gaming
# Supports: Trojan-GFW and Xray XTLS-Reality
# OS: Debian 10/11/12/13, Ubuntu 20.04/22.04/24.04
# FIX: Universal IPv6 dual-stack, firewall, stability, connection drops
###############################################################################

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Global variables
SCRIPT_VERSION="3.2"
INSTALL_DIR="/opt/vpn-gaming"
CONFIG_DIR="/etc/vpn-gaming"
LOG_FILE="/var/log/vpn-gaming-install.log"
CLIENT_DIR="$HOME/vpn-clients"

###############################################################################
# Utility Functions
###############################################################################

print_success() {
    echo -e "${GREEN}[✓]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] SUCCESS: $1" >> "$LOG_FILE"
}

print_error() {
    echo -e "${RED}[✗]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1" >> "$LOG_FILE"
}

print_warning() {
    echo -e "${YELLOW}[!]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARNING: $1" >> "$LOG_FILE"
}

print_info() {
    echo -e "${BLUE}[i]${NC} $1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] INFO: $1" >> "$LOG_FILE"
}

print_prompt() {
    echo -e "${CYAN}[?]${NC} $1"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        print_error "This script must be run as root"
        exit 1
    fi
}

check_os() {
    if [[ -f /etc/os-release ]]; then
        . /etc/os-release
        OS=$ID
        VER=$VERSION_ID
        
        if [[ "$OS" == "debian" ]] || [[ "$OS" == "ubuntu" ]]; then
            print_success "Detected $OS $VER"
            return 0
        else
            print_error "Unsupported OS: $OS"
            print_info "This script only supports Debian and Ubuntu"
            exit 1
        fi
    else
        print_error "Cannot detect OS"
        exit 1
    fi
}

check_internet() {
    print_info "Checking internet connectivity (IPv4 + IPv6)..."
    local ipv4_ok=false
    local ipv6_ok=false

    # Check IPv4 connectivity
    if ping -4 -c 1 -W 5 8.8.8.8 &> /dev/null; then
        ipv4_ok=true
        print_success "IPv4 connectivity: OK"
    else
        print_warning "IPv4 connectivity: FAILED"
    fi

    # Check IPv6 connectivity
    if ping -6 -c 1 -W 5 2001:4860:4860::8888 &> /dev/null; then
        ipv6_ok=true
        print_success "IPv6 connectivity: OK"
    else
        print_warning "IPv6 connectivity: Not available (IPv4-only mode)"
    fi

    if [[ "$ipv4_ok" == false ]] && [[ "$ipv6_ok" == false ]]; then
        print_error "No internet connection (neither IPv4 nor IPv6)"
        exit 1
    fi

    # Store global connectivity flags
    HAS_IPV4=$ipv4_ok
    HAS_IPV6=$ipv6_ok
    return 0
}

generate_random_password() {
    tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32
}

generate_uuid() {
    cat /proc/sys/kernel/random/uuid
}

generate_short_id() {
    tr -dc 'a-f0-9' < /dev/urandom | head -c ${1:-8}
}

###############################################################################
# IPv4/IPv6 Dual-Stack IP Detection Functions
###############################################################################

get_all_ips() {
    # Get all IPv4 addresses on the server
    ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1'
}

get_all_ipv6() {
    # Get all global-scope IPv6 addresses on the server (exclude link-local fe80::)
    ip -6 addr show scope global | grep -oP '(?<=inet6\s)[0-9a-f:]+' | grep -v '^::1$'
}

get_all_dual_stack_ips() {
    # Get all IPv4 and IPv6 addresses combined
    echo "--- IPv4 Addresses ---"
    get_all_ips
    echo "--- IPv6 Addresses ---"
    get_all_ipv6
}

get_main_ip() {
    # Get the main public IPv4 with multiple fallbacks
    local ip

    # Try multiple services with timeout
    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 ipinfo.io/ip 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    ip=$(curl -4 -s --connect-timeout 5 --max-time 10 api.ipify.org 2>/dev/null)
    if [[ -n "$ip" ]] && [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip"
        return 0
    fi

    # Fallback: get first non-localhost IP from server
    ip=$(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '127.0.0.1' | head -n 1)
    if [[ -n "$ip" ]]; then
        echo "$ip"
        return 0
    fi

    # Last resort
    echo "127.0.0.1"
}

get_main_ipv6() {
    # Get the main public IPv6 with multiple fallbacks
    local ip6

    ip6=$(curl -6 -s --connect-timeout 5 --max-time 10 ifconfig.me 2>/dev/null)
    if [[ -n "$ip6" ]] && [[ "$ip6" =~ : ]]; then
        echo "$ip6"
        return 0
    fi

    ip6=$(curl -6 -s --connect-timeout 5 --max-time 10 icanhazip.com 2>/dev/null)
    if [[ -n "$ip6" ]] && [[ "$ip6" =~ : ]]; then
        echo "$ip6"
        return 0
    fi

    ip6=$(curl -6 -s --connect-timeout 5 --max-time 10 api64.ipify.org 2>/dev/null)
    if [[ -n "$ip6" ]] && [[ "$ip6" =~ : ]]; then
        echo "$ip6"
        return 0
    fi

    # Fallback: get first global IPv6 from server interfaces
    ip6=$(ip -6 addr show scope global | grep -oP '(?<=inet6\s)[0-9a-f:]+' | head -n 1)
    if [[ -n "$ip6" ]]; then
        echo "$ip6"
        return 0
    fi

    echo ""
}

is_ipv6() {
    # Check if a given string is an IPv6 address
    [[ "$1" =~ : ]]
}

format_ip_for_url() {
    # Wrap IPv6 in brackets for URLs, leave IPv4 as-is
    if is_ipv6 "$1"; then
        echo "[$1]"
    else
        echo "$1"
    fi
}

format_ip_suffix() {
    # Create a safe suffix from IP (replace dots and colons with dashes)
    echo "$1" | tr '.:' '--'
}

detect_ip_stack() {
    # Detect and display the server's IP stack capabilities
    local ipv4=$(get_main_ip)
    local ipv6=$(get_main_ipv6)

    echo ""
    echo -e "${CYAN}=== Server IP Stack Detection ===${NC}"
    if [[ -n "$ipv4" ]] && [[ "$ipv4" != "127.0.0.1" ]]; then
        echo -e "  ${GREEN}[✓]${NC} IPv4: $ipv4"
    else
        echo -e "  ${RED}[✗]${NC} IPv4: Not detected"
    fi

    if [[ -n "$ipv6" ]]; then
        echo -e "  ${GREEN}[✓]${NC} IPv6: $ipv6"
    else
        echo -e "  ${YELLOW}[!]${NC} IPv6: Not detected (IPv4-only server)"
    fi
    echo ""
}

###############################################################################
# CRITICAL FIX: IPv6 Firewall & Kernel Dual-Stack Setup
# This is the #1 reason IPv6 connections fail - firewall blocks them
###############################################################################

setup_ipv6_firewall() {
    print_info "Configuring IPv6 firewall rules for VPN services..."

    # Ensure ip6tables is available
    if ! command -v ip6tables &> /dev/null; then
        apt install -y iptables > /dev/null 2>&1
    fi

    # Allow established/related connections on IPv6
    ip6tables -C INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || \
        ip6tables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

    # Allow ICMPv6 (REQUIRED for IPv6 to work - neighbor discovery, etc.)
    ip6tables -C INPUT -p ipv6-icmp -j ACCEPT 2>/dev/null || \
        ip6tables -A INPUT -p ipv6-icmp -j ACCEPT

    # Allow loopback on IPv6
    ip6tables -C INPUT -i lo -j ACCEPT 2>/dev/null || \
        ip6tables -A INPUT -i lo -j ACCEPT

    # Allow port 443 TCP on IPv6 (VPN services)
    ip6tables -C INPUT -p tcp --dport 443 -j ACCEPT 2>/dev/null || \
        ip6tables -A INPUT -p tcp --dport 443 -j ACCEPT

    # Allow port 80 TCP on IPv6 (Nginx/certbot)
    ip6tables -C INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null || \
        ip6tables -A INPUT -p tcp --dport 80 -j ACCEPT

    # Allow SSH on IPv6
    ip6tables -C INPUT -p tcp --dport 22 -j ACCEPT 2>/dev/null || \
        ip6tables -A INPUT -p tcp --dport 22 -j ACCEPT

    # Also ensure IPv4 firewall allows the same ports
    if command -v iptables &> /dev/null; then
        iptables -C INPUT -p tcp --dport 443 -j ACCEPT 2>/dev/null || \
            iptables -A INPUT -p tcp --dport 443 -j ACCEPT
        iptables -C INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null || \
            iptables -A INPUT -p tcp --dport 80 -j ACCEPT
    fi

    # Save rules so they persist across reboots
    if command -v netfilter-persistent &> /dev/null; then
        netfilter-persistent save > /dev/null 2>&1
    elif command -v iptables-save &> /dev/null; then
        mkdir -p /etc/iptables
        iptables-save > /etc/iptables/rules.v4 2>/dev/null
        ip6tables-save > /etc/iptables/rules.v6 2>/dev/null
    fi

    print_success "IPv6 firewall rules configured (ports 22, 80, 443 open)"
}

setup_dual_stack_kernel() {
    print_info "Configuring kernel for universal dual-stack support..."

    # CRITICAL: Ensure IPv6 is NOT disabled at kernel level
    # This is the most common reason IPv6 fails on VPS
    sed -i '/net.ipv6.conf.all.disable_ipv6/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.default.disable_ipv6/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.lo.disable_ipv6/d' /etc/sysctl.conf
    sed -i '/net.ipv6.bindv6only/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.all.forwarding/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.default.forwarding/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.all.accept_ra/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.default.accept_ra/d' /etc/sysctl.conf
    sed -i '/net.ipv6.conf.all.accept_redirects/d' /etc/sysctl.conf
    sed -i '/net.ipv4.conf.all.forwarding/d' /etc/sysctl.conf

    cat >> /etc/sysctl.conf << 'EOF'

# === Universal Dual-Stack IPv4/IPv6 Kernel Settings (v3.1) ===
# CRITICAL: Enable IPv6 on all interfaces
net.ipv6.conf.all.disable_ipv6=0
net.ipv6.conf.default.disable_ipv6=0
net.ipv6.conf.lo.disable_ipv6=0

# CRITICAL: Allow :: socket to accept BOTH IPv4 and IPv6 connections
# When set to 0, a socket bound to :: will also accept IPv4 (via IPv4-mapped IPv6)
net.ipv6.bindv6only=0

# Enable forwarding for both stacks (needed for VPN routing)
net.ipv4.conf.all.forwarding=1
net.ipv6.conf.all.forwarding=1
net.ipv6.conf.default.forwarding=1

# Accept Router Advertisements even with forwarding enabled
# Value 2 = accept RA even when forwarding is on (critical for VPS IPv6)
net.ipv6.conf.all.accept_ra=2
net.ipv6.conf.default.accept_ra=2

# Accept IPv6 redirects
net.ipv6.conf.all.accept_redirects=1
EOF

    # Apply immediately
    sysctl -w net.ipv6.conf.all.disable_ipv6=0 > /dev/null 2>&1
    sysctl -w net.ipv6.conf.default.disable_ipv6=0 > /dev/null 2>&1
    sysctl -w net.ipv6.conf.lo.disable_ipv6=0 > /dev/null 2>&1
    sysctl -w net.ipv6.bindv6only=0 > /dev/null 2>&1
    sysctl -w net.ipv4.conf.all.forwarding=1 > /dev/null 2>&1
    sysctl -w net.ipv6.conf.all.forwarding=1 > /dev/null 2>&1
    sysctl -w net.ipv6.conf.default.forwarding=1 > /dev/null 2>&1
    sysctl -w net.ipv6.conf.all.accept_ra=2 > /dev/null 2>&1
    sysctl -w net.ipv6.conf.default.accept_ra=2 > /dev/null 2>&1
    sysctl -w net.ipv6.conf.all.accept_redirects=1 > /dev/null 2>&1

    # Also check /etc/default/grub for ipv6.disable=1
    if [[ -f /etc/default/grub ]]; then
        if grep -q 'ipv6.disable=1' /etc/default/grub; then
            print_warning "Found ipv6.disable=1 in GRUB config, removing..."
            sed -i 's/ipv6.disable=1//g' /etc/default/grub
            update-grub > /dev/null 2>&1
            print_warning "GRUB updated - reboot required for full IPv6 support"
        fi
    fi

    # Check /etc/modprobe.d/ for IPv6 disable
    if grep -rq 'options ipv6 disable=1' /etc/modprobe.d/ 2>/dev/null; then
        print_warning "Found IPv6 disabled in modprobe, fixing..."
        sed -i 's/options ipv6 disable=1/options ipv6 disable=0/g' /etc/modprobe.d/*.conf 2>/dev/null
    fi

    sysctl -p > /dev/null 2>&1
    print_success "Dual-stack kernel configured (IPv6 enabled, bindv6only=0)"
}

###############################################################################
# System Optimization Functions (Dual-Stack IPv4/IPv6)
###############################################################################

enable_bbr() {
    print_info "Enabling TCP BBR congestion control with a low-latency qdisc profile..."

    if ! sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr; then
        print_warning "TCP BBR is not available in this kernel"
        return 1
    fi

    sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf
    sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf

    cat >> /etc/sysctl.conf << 'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF

    sysctl -p > /dev/null 2>&1

    if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -qw bbr; then
        print_success "TCP BBR enabled successfully (qdisc=fq)"
    else
        print_error "Failed to enable TCP BBR"
        return 1
    fi
}

