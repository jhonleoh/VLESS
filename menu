        local xray_grpc_bind=$(ss -tlnp | grep 'grpc-reality-config.json' | awk '{print $4}' | head -1)
        if [[ -z "$xray_grpc_bind" ]]; then
            xray_grpc_bind=$(ss -tlnp | grep xray | awk '{print $4}' | head -1)
        fi
        if echo "$xray_grpc_bind" | grep -q '^\*:' || echo "$xray_grpc_bind" | grep -q '^\[::\]:'; then
            echo -e "${GREEN}[✓]${NC} Xray REALITY + gRPC: Running (IPv4+IPv6)"
        else
            echo -e "${GREEN}[✓]${NC} Xray REALITY + gRPC: Running"
        fi
    fi
    if systemctl is-active --quiet stunnel4 && [[ -f /etc/stunnel/ssh-ws.conf ]]; then
        local ssh_ssl_port=$(grep '^SSH_SSL_PORT=' /usr/local/etc/ssh-ws/config.env 2>/dev/null | cut -d= -f2-)
        echo -e "${GREEN}[✓]${NC} SSH SSL/TLS (stunnel): Running on port ${ssh_ssl_port:-443}"
    fi
