    echo -e " ${CYAN} 1.${NC} Install Trojan-GFW (Dual-Stack)"
    echo -e " ${CYAN} 2.${NC} Install Xray (VLESS + XTLS-Reality, Dual-Stack)"
    echo -e " ${CYAN} 3.${NC} Add Trojan on Additional IP (IPv4/IPv6)"
    echo -e " ${CYAN} 4.${NC} Add Xray on Additional IP (IPv4/IPv6)"
    echo -e " ${CYAN} 5.${NC} Switch Protocol (Trojan <-> Xray)"
    echo -e " ${CYAN} 6.${NC} View Connection Info"
