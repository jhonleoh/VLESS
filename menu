ensure_leading_slash() {
    local value="$1"
    if [[ -z "$value" ]]; then
        echo "/"
    elif [[ "$value" == /* ]]; then
        echo "$value"
    else
        echo "/$value"
    fi
}

stop_conflicting_vpn_services() {
    print_info "Stopping active VPN services that may conflict on shared listener ports..."
    local stopped_any=false

    for svc in trojan xray trojan-go xray-ws xray-httpupgrade xray-grpc-reality stunnel4 ssh-ws; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            systemctl stop "$svc"
            print_warning "Stopped $svc to prevent listener port conflicts"
            stopped_any=true
        fi
    done

    for service in /etc/systemd/system/trojan-*.service /etc/systemd/system/xray-*.service; do
        if [[ -f "$service" ]]; then
            local svcname=$(basename "$service" .service)
            if systemctl is-active --quiet "$svcname" 2>/dev/null; then
                systemctl stop "$svcname"
                print_warning "Stopped $svcname to prevent listener port conflicts"
                stopped_any=true
            fi
        fi
    done

    if [[ "$stopped_any" == false ]]; then
        print_success "No conflicting listener services detected"
    fi
}

setup_transport_web_stack() {
    local cert_dir="$1"

    print_info "Installing dependencies for advanced CDN-based transports..."
    apt update > /dev/null 2>&1
    apt install -y nginx certbot python3-certbot-nginx curl jq qrencode xz-utils ethtool iptables-persistent unzip openssl > /dev/null 2>&1
    print_success "Dependencies installed"

    print_prompt "Enter your domain name for TLS/CDN routing (or press Enter to use server IP with self-signed cert):"
    read -r DOMAIN

    if [[ -z "$DOMAIN" ]]; then
        DOMAIN=$(get_main_ip)
        USE_CERT=false
        print_warning "No domain provided. Falling back to server IP with a self-signed certificate"
    else
        USE_CERT=true
        print_info "Using domain: $DOMAIN"
    fi

    cat > /etc/nginx/sites-available/default << EOF
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    root /var/www/html;
    index index.html;

    location / {
        try_files \$uri \$uri/ =404;
    }
}
EOF

    cat > /var/www/html/index.html << 'EOF'
<!DOCTYPE html>
<html>
<head>
    <title>Welcome</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; padding: 50px; }
        h1 { color: #333; }
    </style>
</head>
<body>
    <h1>Welcome to My Server</h1>
    <p>CDN-friendly transport stack is active.</p>
</body>
</html>
EOF

    systemctl enable nginx > /dev/null 2>&1
    systemctl restart nginx > /dev/null 2>&1

    mkdir -p "$cert_dir"
    CERT_PATH=""
    KEY_PATH=""

    if [[ "$USE_CERT" == true ]]; then
        print_info "Obtaining TLS certificate from Let's Encrypt..."
        print_warning "Make sure your domain points to this server IP: $(get_main_ip)"
        local ipv6_addr=$(get_main_ipv6)
        if [[ -n "$ipv6_addr" ]]; then
            print_warning "Also add an AAAA record pointing to: $ipv6_addr"
        fi
        read -p "Press Enter to continue..."

        certbot certonly --nginx -d "$DOMAIN" --non-interactive --agree-tos --register-unsafely-without-email > /dev/null 2>&1
        if [[ $? -eq 0 ]]; then
            CERT_PATH="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"
            KEY_PATH="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
            chmod +rx /etc/letsencrypt/live 2>/dev/null
            chmod +rx /etc/letsencrypt/archive 2>/dev/null
            chmod -R +r "/etc/letsencrypt/archive/$DOMAIN" 2>/dev/null
            print_success "TLS certificate obtained successfully"
        else
            print_warning "Certificate issuance failed. Falling back to self-signed certificate"
            USE_CERT=false
        fi
    fi

    if [[ "$USE_CERT" == false ]]; then
        local cert_subject="/C=US/ST=State/L=City/O=VPNGaming/CN=$DOMAIN"
        local san_value=""
        local ipv6_addr=$(get_main_ipv6)

        if [[ "$DOMAIN" =~ : ]] || [[ "$DOMAIN" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            san_value="IP:$DOMAIN"
            if [[ -n "$ipv6_addr" ]] && [[ "$DOMAIN" != "$ipv6_addr" ]]; then
                san_value="$san_value,IP:$ipv6_addr"
            fi
        else
            san_value="DNS:$DOMAIN"
        fi

        openssl req -new -newkey rsa:2048 -days 365 -nodes -x509             -subj "$cert_subject"             -addext "subjectAltName=$san_value"             -keyout "$cert_dir/private.key"             -out "$cert_dir/certificate.crt" > /dev/null 2>&1

        CERT_PATH="$cert_dir/certificate.crt"
        KEY_PATH="$cert_dir/private.key"
        print_success "Self-signed certificate generated"
    fi

    CLIENT_ALLOW_INSECURE=$([ "$USE_CERT" == true ] && echo "false" || echo "true")
    REMOTE_ENDPOINT="$DOMAIN"
}

