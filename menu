###############################################################################
# Speed Test Module (IPv4 vs IPv6 Comparison)
###############################################################################

speed_test() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Network Speed & Latency Test                ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # IPv4 latency test
    echo -e "${CYAN}=== IPv4 Latency Test ===${NC}"
    if ping -4 -c 5 -W 3 8.8.8.8 &> /dev/null; then
        local ipv4_ping=$(ping -4 -c 5 -W 3 8.8.8.8 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Google DNS (8.8.8.8): ${GREEN}${ipv4_ping}ms${NC}"
    else
        echo -e "  Google DNS (8.8.8.8): ${RED}Unreachable${NC}"
    fi

    if ping -4 -c 5 -W 3 1.1.1.1 &> /dev/null; then
        local ipv4_cf=$(ping -4 -c 5 -W 3 1.1.1.1 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Cloudflare (1.1.1.1): ${GREEN}${ipv4_cf}ms${NC}"
    else
        echo -e "  Cloudflare (1.1.1.1): ${RED}Unreachable${NC}"
    fi
    echo ""

    # IPv6 latency test
    echo -e "${CYAN}=== IPv6 Latency Test ===${NC}"
    if ping -6 -c 5 -W 3 2001:4860:4860::8888 &> /dev/null; then
        local ipv6_ping=$(ping -6 -c 5 -W 3 2001:4860:4860::8888 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Google DNS (2001:4860:4860::8888): ${GREEN}${ipv6_ping}ms${NC}"
    else
        echo -e "  Google DNS (2001:4860:4860::8888): ${YELLOW}Not available${NC}"
    fi

    if ping -6 -c 5 -W 3 2606:4700:4700::1111 &> /dev/null; then
        local ipv6_cf=$(ping -6 -c 5 -W 3 2606:4700:4700::1111 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Cloudflare (2606:4700:4700::1111): ${GREEN}${ipv6_cf}ms${NC}"
    else
        echo -e "  Cloudflare (2606:4700:4700::1111): ${YELLOW}Not available${NC}"
    fi
    echo ""

    # Download speed test
    echo -e "${CYAN}=== Download Speed Test ===${NC}"
    print_info "Testing IPv4 download speed..."
    local ipv4_speed=$(curl -4 -s -o /dev/null -w '%{speed_download}' --connect-timeout 10 --max-time 15 http://speedtest.tele2.net/1MB.zip 2>/dev/null)
    if [[ -n "$ipv4_speed" ]] && [[ "$ipv4_speed" != "0.000" ]]; then
        local ipv4_mbps=$(echo "scale=2; $ipv4_speed / 1048576" | bc 2>/dev/null)
        echo -e "  IPv4 Download: ${GREEN}${ipv4_mbps} MB/s${NC}"
    else
        echo -e "  IPv4 Download: ${RED}Failed${NC}"
    fi

    print_info "Testing IPv6 download speed..."
    local ipv6_speed=$(curl -6 -s -o /dev/null -w '%{speed_download}' --connect-timeout 10 --max-time 15 http://speedtest.tele2.net/1MB.zip 2>/dev/null)
    if [[ -n "$ipv6_speed" ]] && [[ "$ipv6_speed" != "0.000" ]]; then
        local ipv6_mbps=$(echo "scale=2; $ipv6_speed / 1048576" | bc 2>/dev/null)
        echo -e "  IPv6 Download: ${GREEN}${ipv6_mbps} MB/s${NC}"
    else
        echo -e "  IPv6 Download: ${YELLOW}Not available or failed${NC}"
    fi
    echo ""

    # System optimization status
    echo -e "${CYAN}=== Optimization Status ===${NC}"
    if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr; then
        echo -e "  BBR Congestion Control: ${GREEN}Enabled${NC}"
    else
        echo -e "  BBR Congestion Control: ${RED}Disabled${NC}"
    fi

    if sysctl net.ipv4.tcp_fastopen 2>/dev/null | grep -q 3; then
        echo -e "  TCP Fast Open: ${GREEN}Enabled (client+server)${NC}"
    else
        echo -e "  TCP Fast Open: ${YELLOW}Partial or disabled${NC}"
    fi

    local cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    echo -e "  Congestion Algorithm: ${CYAN}$cc${NC}"

    local qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null)
    echo -e "  Queue Discipline: ${CYAN}$qdisc${NC}"

    if sysctl net.ipv6.conf.all.forwarding 2>/dev/null | grep -q 1; then
        echo -e "  IPv6 Forwarding: ${GREEN}Enabled${NC}"
    else
        echo -e "  IPv6 Forwarding: ${RED}Disabled${NC}"
    fi

    local bindv6=$(sysctl -n net.ipv6.bindv6only 2>/dev/null)
    if [[ "$bindv6" == "0" ]]; then
        echo -e "  Dual-Stack Binding: ${GREEN}Enabled (bindv6only=0)${NC}"
    else
        echo -e "  Dual-Stack Binding: ${RED}Disabled (bindv6only=$bindv6)${NC}"
    fi

    local disable_ipv6=$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null)
    if [[ "$disable_ipv6" == "0" ]]; then
        echo -e "  IPv6 Stack: ${GREEN}Enabled${NC}"
    else
        echo -e "  IPv6 Stack: ${RED}Disabled at kernel level${NC}"
    fi

    local nofile=$(ulimit -n 2>/dev/null)
    echo -e "  File Descriptors Limit: ${CYAN}$nofile${NC}"

    echo ""
    read -p "Press Enter to continue..."
}

###############################################################################
# IPv6 Status & Diagnostics (Enhanced v3.1)
###############################################################################

ipv6_diagnostics() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   IPv6 Diagnostics & Status (v3.1)            ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Interface addresses
    echo -e "${CYAN}=== Network Interfaces ===${NC}"
    echo -e "${YELLOW}IPv4 Addresses:${NC}"
    ip -4 addr show | grep 'inet ' | awk '{print "  " $2 " on " $NF}'
    echo ""
    echo -e "${YELLOW}IPv6 Addresses:${NC}"
    ip -6 addr show | grep 'inet6 ' | awk '{print "  " $2 " scope " $4 " on " $NF}'
    echo ""

    # Default routes
    echo -e "${CYAN}=== Default Routes ===${NC}"
    echo -e "${YELLOW}IPv4 Default Route:${NC}"
    ip -4 route show default | head -3 | awk '{print "  " $0}'
    echo ""
    echo -e "${YELLOW}IPv6 Default Route:${NC}"
    local ipv6_route=$(ip -6 route show default 2>/dev/null | head -3)
    if [[ -n "$ipv6_route" ]]; then
        echo "$ipv6_route" | awk '{print "  " $0}'
    else
        echo -e "  ${RED}No IPv6 default route found${NC}"
        echo -e "  ${YELLOW}This means IPv6 connectivity is not available${NC}"
    fi
    echo ""

    # Public IPs
    echo -e "${CYAN}=== Public IP Addresses ===${NC}"
    local pub4=$(get_main_ip)
    local pub6=$(get_main_ipv6)
    echo -e "  Public IPv4: ${GREEN}$pub4${NC}"
    if [[ -n "$pub6" ]]; then
        echo -e "  Public IPv6: ${GREEN}$pub6${NC}"
    else
        echo -e "  Public IPv6: ${YELLOW}Not detected${NC}"
    fi
    echo ""

    # Kernel IPv6 settings (CRITICAL for debugging)
    echo -e "${CYAN}=== Kernel IPv6 Settings (Critical) ===${NC}"
    local disable_v6=$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null)
    local forwarding=$(sysctl -n net.ipv6.conf.all.forwarding 2>/dev/null)
    local accept_ra=$(sysctl -n net.ipv6.conf.all.accept_ra 2>/dev/null)
    local bindv6only=$(sysctl -n net.ipv6.bindv6only 2>/dev/null)

    if [[ "$disable_v6" == "0" ]]; then
        echo -e "  disable_ipv6: ${GREEN}0 (IPv6 enabled)${NC}"
    else
        echo -e "  disable_ipv6: ${RED}$disable_v6 (IPv6 DISABLED - this is the problem!)${NC}"
    fi

    if [[ "$forwarding" == "1" ]]; then
        echo -e "  forwarding:   ${GREEN}1 (enabled)${NC}"
    else
        echo -e "  forwarding:   ${RED}$forwarding (disabled)${NC}"
    fi

    if [[ "$accept_ra" == "2" ]]; then
        echo -e "  accept_ra:    ${GREEN}2 (accept even with forwarding)${NC}"
    else
        echo -e "  accept_ra:    ${YELLOW}$accept_ra (should be 2 for VPS)${NC}"
    fi

    if [[ "$bindv6only" == "0" ]]; then
        echo -e "  bindv6only:   ${GREEN}0 (:: accepts IPv4+IPv6)${NC}"
    else
        echo -e "  bindv6only:   ${RED}$bindv6only (:: only accepts IPv6 - PROBLEM!)${NC}"
    fi
    echo ""

    # Firewall check
    echo -e "${CYAN}=== IPv6 Firewall (ip6tables) ===${NC}"
    local ip6_443=$(ip6tables -L INPUT -n 2>/dev/null | grep -c 'dpt:443')
    if [[ "$ip6_443" -gt 0 ]]; then
        echo -e "  Port 443/tcp: ${GREEN}OPEN${NC}"
    else
        echo -e "  Port 443/tcp: ${RED}NOT FOUND in ip6tables (IPv6 connections blocked!)${NC}"
    fi

    local ip6_icmp=$(ip6tables -L INPUT -n 2>/dev/null | grep -c 'ipv6-icmp')
    if [[ "$ip6_icmp" -gt 0 ]]; then
        echo -e "  ICMPv6:       ${GREEN}ALLOWED${NC}"
    else
        echo -e "  ICMPv6:       ${RED}NOT FOUND (IPv6 neighbor discovery may fail!)${NC}"
    fi
    echo ""

    # DNS resolution test
    echo -e "${CYAN}=== DNS Resolution Test ===${NC}"
    if command -v host &> /dev/null; then
        if host -t AAAA google.com &> /dev/null; then
            local aaaa=$(host -t AAAA google.com 2>/dev/null | grep 'has IPv6' | head -1)
            echo -e "  google.com AAAA: ${GREEN}$aaaa${NC}"
        else
            echo -e "  google.com AAAA: ${YELLOW}DNS lookup failed${NC}"
        fi
    else
        echo -e "  ${YELLOW}host command not available, skipping DNS test${NC}"
    fi
    echo ""

    # Service binding check (CRITICAL)
    echo -e "${CYAN}=== VPN Service Binding (Critical) ===${NC}"
    if systemctl is-active --quiet trojan; then
        echo -e "  ${CYAN}Trojan listening on:${NC}"
        ss -tlnp | grep trojan | awk '{print "    " $4}' | head -5
        local trojan_bind=$(ss -tlnp | grep trojan | awk '{print $4}' | head -1)
        if echo "$trojan_bind" | grep -q '^\*:' || echo "$trojan_bind" | grep -q '^\[::\]:'; then
            echo -e "    ${GREEN}=> Dual-stack OK (listening on all interfaces)${NC}"
        elif echo "$trojan_bind" | grep -q '0.0.0.0:'; then
            echo -e "    ${YELLOW}=> IPv4 only (check bindv6only setting)${NC}"
        fi
    else
        echo -e "  Trojan: ${YELLOW}Not running${NC}"
    fi

    if systemctl is-active --quiet xray; then
        echo -e "  ${CYAN}Xray listening on:${NC}"
        ss -tlnp | grep xray | awk '{print "    " $4}' | head -5
        local xray_bind=$(ss -tlnp | grep xray | awk '{print $4}' | head -1)
        if echo "$xray_bind" | grep -q '^\*:' || echo "$xray_bind" | grep -q '^\[::\]:'; then
            echo -e "    ${GREEN}=> Dual-stack OK (listening on all interfaces)${NC}"
        elif echo "$xray_bind" | grep -q '0.0.0.0:'; then
            echo -e "    ${YELLOW}=> IPv4 only (check bindv6only setting)${NC}"
        fi
    else
        echo -e "  Xray: ${YELLOW}Not running${NC}"
    fi
    echo ""

    # Quick fix option
    echo -e "${CYAN}=== Quick Fix ===${NC}"
    echo "  If IPv6 is not working, run option 11 (Gaming Optimization)"
    echo "  It will automatically fix kernel settings and firewall rules"
    echo ""

    read -p "Press Enter to continue..."
}

###############################################################################
# Repair & Fix Dual-Stack (NEW in v3.1)
###############################################################################

repair_dual_stack() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Repair Dual-Stack IPv4/IPv6 (v3.1)          ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    print_info "Running comprehensive dual-stack repair..."
    echo ""

    # Step 1: Fix kernel settings
    echo -e "${CYAN}Step 1: Fixing kernel IPv6 settings...${NC}"
    setup_dual_stack_kernel
    echo ""

    # Step 2: Fix firewall
    echo -e "${CYAN}Step 2: Fixing IPv6 firewall rules...${NC}"
    setup_ipv6_firewall
    echo ""

    # Step 3: Fix Trojan config if installed
    if [[ -f /usr/local/etc/trojan/config.json ]]; then
        echo -e "${CYAN}Step 3: Fixing Trojan configuration...${NC}"
        local current_addr=$(jq -r '.local_addr' /usr/local/etc/trojan/config.json 2>/dev/null)
        if [[ "$current_addr" != "::" ]]; then
            print_warning "Trojan was bound to '$current_addr', fixing to '::'..."
            jq '.local_addr = "::"' /usr/local/etc/trojan/config.json > /tmp/trojan-fix.json && \
                mv /tmp/trojan-fix.json /usr/local/etc/trojan/config.json
            print_success "Trojan config fixed to listen on :: (dual-stack)"
        else
            print_success "Trojan already configured for dual-stack (::)"
        fi

        # Fix TCP settings
        local keep_alive=$(jq -r '.tcp.keep_alive' /usr/local/etc/trojan/config.json 2>/dev/null)
        if [[ "$keep_alive" != "true" ]]; then
            print_warning "Trojan TCP keep_alive was disabled, enabling..."
            jq '.tcp.keep_alive = true | .tcp.no_delay = true | .tcp.reuse_port = true | .tcp.fast_open = true | .tcp.prefer_ipv4 = false' \
                /usr/local/etc/trojan/config.json > /tmp/trojan-fix.json && \
                mv /tmp/trojan-fix.json /usr/local/etc/trojan/config.json
            print_success "Trojan TCP settings fixed"
        fi

        # Fix session_timeout
        local session_timeout=$(jq -r '.ssl.session_timeout' /usr/local/etc/trojan/config.json 2>/dev/null)
        if [[ "$session_timeout" != "3600" ]] && [[ "$session_timeout" != "null" ]]; then
            jq '.ssl.session_timeout = 3600' /usr/local/etc/trojan/config.json > /tmp/trojan-fix.json && \
                mv /tmp/trojan-fix.json /usr/local/etc/trojan/config.json
            print_success "Trojan session_timeout fixed to 3600"
        fi

        # Restart Trojan
        if systemctl is-active --quiet trojan; then
            systemctl restart trojan
            sleep 2
            if systemctl is-active --quiet trojan; then
                print_success "Trojan restarted successfully"
            else
                print_error "Trojan failed to restart"
                journalctl -u trojan -n 5 --no-pager
            fi
        fi
        echo ""
    fi

    # Step 4: Fix Xray config if installed
    if [[ -f /usr/local/etc/xray/config.json ]]; then
        echo -e "${CYAN}Step 4: Fixing Xray configuration...${NC}"
        local xray_listen=$(jq -r '.inbounds[0].listen' /usr/local/etc/xray/config.json 2>/dev/null)
        if [[ "$xray_listen" != "::" ]]; then
            print_warning "Xray was bound to '$xray_listen', fixing to '::'..."
            jq '.inbounds[0].listen = "::"' /usr/local/etc/xray/config.json > /tmp/xray-fix.json && \
                mv /tmp/xray-fix.json /usr/local/etc/xray/config.json
            print_success "Xray config fixed to listen on :: (dual-stack)"
        else
            print_success "Xray already configured for dual-stack (::)"
        fi

        # Add/fix sockopt for keepalive (prevents connection drops)
        local has_sockopt=$(jq '.inbounds[0].streamSettings.sockopt' /usr/local/etc/xray/config.json 2>/dev/null)
        if [[ "$has_sockopt" == "null" ]]; then
            print_warning "Xray missing sockopt (keepalive), adding..."
            jq '.inbounds[0].streamSettings.sockopt = {"tcpKeepAliveIdle": 60, "tcpKeepAliveInterval": 30, "tcpFastOpen": true, "tcpNoDelay": true}' \
                /usr/local/etc/xray/config.json > /tmp/xray-fix.json && \
                mv /tmp/xray-fix.json /usr/local/etc/xray/config.json
            print_success "Xray sockopt added (keepalive enabled)"
        fi

        # Fix freedom outbound domainStrategy
        local dom_strat=$(jq -r '.outbounds[0].settings.domainStrategy' /usr/local/etc/xray/config.json 2>/dev/null)
        if [[ "$dom_strat" != "UseIPv4v6" ]]; then
            print_warning "Xray freedom outbound domainStrategy was '$dom_strat', fixing to 'UseIPv4v6'..."
            jq '.outbounds[0].settings.domainStrategy = "UseIPv4v6"' \
                /usr/local/etc/xray/config.json > /tmp/xray-fix.json && \
                mv /tmp/xray-fix.json /usr/local/etc/xray/config.json
            print_success "Xray outbound domainStrategy fixed"
        fi

        # Add sockopt to outbound too
        local out_sockopt=$(jq '.outbounds[0].streamSettings.sockopt' /usr/local/etc/xray/config.json 2>/dev/null)
        if [[ "$out_sockopt" == "null" ]]; then
            jq '.outbounds[0].streamSettings = {"sockopt": {"tcpKeepAliveIdle": 60, "tcpKeepAliveInterval": 30, "tcpFastOpen": true, "tcpNoDelay": true}}' \
                /usr/local/etc/xray/config.json > /tmp/xray-fix.json && \
                mv /tmp/xray-fix.json /usr/local/etc/xray/config.json
            print_success "Xray outbound sockopt added"
        fi

        # Fix connIdle timeout
        local conn_idle=$(jq -r '.policy.levels."0".connIdle' /usr/local/etc/xray/config.json 2>/dev/null)
        if [[ "$conn_idle" -lt 300 ]] 2>/dev/null; then
            jq '.policy.levels."0".connIdle = 300 | .policy.levels."0".handshake = 8' \
                /usr/local/etc/xray/config.json > /tmp/xray-fix.json && \
                mv /tmp/xray-fix.json /usr/local/etc/xray/config.json
            print_success "Xray connIdle fixed to 300s"
        fi

        # Restart Xray
        if systemctl is-active --quiet xray; then
            systemctl restart xray
            sleep 2
            if systemctl is-active --quiet xray; then
                print_success "Xray restarted successfully"
            else
                print_error "Xray failed to restart"
                journalctl -u xray -n 5 --no-pager
            fi
        fi
        echo ""
    fi

    # Step 5: Verify
    echo -e "${CYAN}Step 5: Verification...${NC}"
    echo ""

    # Check binding
    echo -e "  ${YELLOW}Service binding status:${NC}"
    ss -tlnp | grep ':443' | awk '{print "    " $4 " (" $6 ")"}'
    echo ""

    # Check kernel
    local bv6=$(sysctl -n net.ipv6.bindv6only 2>/dev/null)
    local dv6=$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null)
    echo -e "  bindv6only: $bv6 $([ "$bv6" == "0" ] && echo -e "${GREEN}(OK)${NC}" || echo -e "${RED}(PROBLEM)${NC}")"
    echo -e "  disable_ipv6: $dv6 $([ "$dv6" == "0" ] && echo -e "${GREEN}(OK)${NC}" || echo -e "${RED}(PROBLEM)${NC}")"

    echo ""
    print_success "Dual-stack repair complete!"
    print_info "If issues persist, try rebooting the server"
    echo ""
    read -p "Press Enter to continue..."
}

###############################################################################
# Uninstall
###############################################################################

uninstall_vpn() {
    clear
    echo -e "${RED}╔════════════════════════════════════════╗${NC}"
    echo -e "${RED}║   Uninstall VPN Services               ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════╝${NC}"
    echo ""

    print_warning "This will remove all VPN services and configurations"
    read -p "Are you sure? (yes/no): " -r CONFIRM

    if [[ "$CONFIRM" != "yes" ]]; then
        print_info "Uninstall cancelled"
        return 0
    fi

    # Stop and remove main Trojan
    if systemctl is-active --quiet trojan; then
        print_info "Removing Trojan..."
        systemctl stop trojan
        systemctl disable trojan > /dev/null 2>&1
        rm -f /etc/systemd/system/trojan.service
        rm -f /usr/local/bin/trojan
        rm -rf /usr/local/etc/trojan
        print_success "Trojan removed"
    fi

    # Stop and remove additional Trojan instances
    for service in /etc/systemd/system/trojan-*.service; do
        if [[ -f "$service" ]]; then
            SERVICE_NAME=$(basename "$service" .service)
            print_info "Removing $SERVICE_NAME..."
            systemctl stop "$SERVICE_NAME"
            systemctl disable "$SERVICE_NAME" > /dev/null 2>&1
            rm -f "$service"
            print_success "$SERVICE_NAME removed"
        fi
    done

    # Stop and remove main Xray
    if systemctl is-active --quiet xray; then
        print_info "Removing Xray..."
        systemctl stop xray
        systemctl disable xray > /dev/null 2>&1
        bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ remove > /dev/null 2>&1
        print_success "Xray removed"
    fi

    # Stop and remove additional Xray instances
    for service in /etc/systemd/system/xray-*.service; do
        if [[ -f "$service" ]]; then
            SERVICE_NAME=$(basename "$service" .service)

            case "$SERVICE_NAME" in
                xray-ws|xray-httpupgrade|xray-grpc-reality)
                    continue
                    ;;
            esac

            print_info "Removing $SERVICE_NAME..."
            systemctl stop "$SERVICE_NAME"
            systemctl disable "$SERVICE_NAME" > /dev/null 2>&1
            rm -f "$service"
            print_success "$SERVICE_NAME removed"
        fi
    done

    # Remove Trojan-Go
    if systemctl list-unit-files 2>/dev/null | grep -q '^trojan-go\.service'; then
        print_info "Removing Trojan-Go..."
        systemctl stop trojan-go > /dev/null 2>&1
        systemctl disable trojan-go > /dev/null 2>&1
        rm -f /etc/systemd/system/trojan-go.service
        rm -f /usr/local/bin/trojan-go
        rm -rf /usr/local/etc/trojan-go
        print_success "Trojan-Go removed"
    fi

    # Remove Xray WS service/config
    if [[ -f /etc/systemd/system/xray-ws.service ]]; then
        print_info "Removing Xray WS service..."
        systemctl stop xray-ws > /dev/null 2>&1
        systemctl disable xray-ws > /dev/null 2>&1
        rm -f /etc/systemd/system/xray-ws.service
        rm -f /usr/local/etc/xray/ws-config.json
        print_success "Xray WS service removed"
    fi

    # Remove advanced Xray HTTPUpgrade service/config
    if [[ -f /etc/systemd/system/xray-httpupgrade.service ]]; then
        print_info "Removing Xray HTTPUpgrade service..."
        systemctl stop xray-httpupgrade > /dev/null 2>&1
        systemctl disable xray-httpupgrade > /dev/null 2>&1
        rm -f /etc/systemd/system/xray-httpupgrade.service
        rm -f /usr/local/etc/xray/httpupgrade-config.json
        print_success "Xray HTTPUpgrade service removed"
    fi

    # Remove Xray REALITY + gRPC service/config
    if [[ -f /etc/systemd/system/xray-grpc-reality.service ]]; then
        print_info "Removing Xray REALITY + gRPC service..."
        systemctl stop xray-grpc-reality > /dev/null 2>&1
        systemctl disable xray-grpc-reality > /dev/null 2>&1
        rm -f /etc/systemd/system/xray-grpc-reality.service
        rm -f /usr/local/etc/xray/grpc-reality-config.json
        print_success "Xray REALITY + gRPC service removed"
    fi

    # Remove SSH + SSL/WS service/config
    if [[ -f /etc/systemd/system/ssh-ws.service ]] || [[ -f /etc/stunnel/ssh-ws.conf ]] || [[ -d /usr/local/etc/ssh-ws ]]; then
        print_info "Removing SSH + SSL/WS services and configuration..."

        if [[ -f /usr/local/etc/ssh-ws/users.list ]]; then
            while IFS= read -r SSH_WS_USER; do
                if [[ -n "$SSH_WS_USER" ]] && id "$SSH_WS_USER" >/dev/null 2>&1; then
                    userdel -r "$SSH_WS_USER" > /dev/null 2>&1 || userdel "$SSH_WS_USER" > /dev/null 2>&1
                    print_success "Removed SSH user $SSH_WS_USER"
                fi
            done < /usr/local/etc/ssh-ws/users.list
        fi

        if getent group ssh-ws-users > /dev/null 2>&1; then
            groupdel ssh-ws-users > /dev/null 2>&1 || true
        fi

        systemctl stop ssh-ws > /dev/null 2>&1
        systemctl disable ssh-ws > /dev/null 2>&1
        rm -f /etc/systemd/system/ssh-ws.service

        if [[ -f /etc/stunnel/ssh-ws.conf ]]; then
            rm -f /etc/stunnel/ssh-ws.conf
        fi

        sed -i '/# VPN Gaming SSH WS START/,/# VPN Gaming SSH WS END/d' /etc/ssh/sshd_config
        rm -rf /usr/local/etc/ssh-ws
        rm -f /usr/local/bin/ssh-ws-shell

        if compgen -G "/etc/stunnel/*.conf" > /dev/null; then
            systemctl restart stunnel4 > /dev/null 2>&1
        else
            systemctl stop stunnel4 > /dev/null 2>&1
            systemctl disable stunnel4 > /dev/null 2>&1
        fi

        if systemctl list-unit-files 2>/dev/null | grep -q '^ssh\.service'; then
            systemctl restart ssh > /dev/null 2>&1
        else
            systemctl restart sshd > /dev/null 2>&1
        fi

        print_success "SSH + SSL/WS service removed"
    fi

    # Remove client configs
    if [[ -d "$CLIENT_DIR" ]]; then
        print_info "Removing client configurations..."
        rm -rf "$CLIENT_DIR"
        print_success "Client configurations removed"
    fi

    systemctl daemon-reload

    echo ""
    print_success "Uninstall complete!"
    echo ""
    read -p "Press Enter to continue..."
}

