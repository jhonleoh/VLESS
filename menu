#!/usr/bin/env python3
import asyncio
import signal
import ssl
from urllib.parse import urlparse

from websockets.asyncio.server import serve

WS_LOCAL_HOST = "${SSH_WS_LOCAL_HOST}"
WS_LOCAL_PORT = int(${SSH_WS_LOCAL_PORT})
TLS_PORT = int(${SSH_WS_PORT})
WS_PATH = "${SSH_WS_PATH}"
SSH_HOST = "127.0.0.1"
SSH_PORT = 22
CERT_PATH = "${CERT_PATH}"
KEY_PATH = "${KEY_PATH}"
HTTP_METHODS = (
    b"GET ",
    b"POST ",
    b"HEAD ",
    b"OPTIONS ",
    b"PUT ",
    b"PATCH ",
    b"DELETE ",
    b"CONNECT ",
)


async def ws_bridge(websocket):
    parsed = urlparse(websocket.request.path)
    if parsed.path != WS_PATH:
        await websocket.close(code=1008, reason="Invalid WebSocket path")
        return

    try:
        reader, writer = await asyncio.open_connection(SSH_HOST, SSH_PORT)
    except Exception:
        await websocket.close(code=1011, reason="SSH backend unavailable")
        return

    async def ws_to_tcp():
        try:
            async for message in websocket:
                if isinstance(message, str):
                    message = message.encode()
                writer.write(message)
                await writer.drain()
        except Exception:
            pass
        finally:
            try:
                writer.close()
                await writer.wait_closed()
            except Exception:
                pass

    async def tcp_to_ws():
        try:
            while True:
                data = await reader.read(32768)
                if not data:
                    break
                await websocket.send(data)
        except Exception:
            pass
        finally:
            try:
                await websocket.close()
            except Exception:
                pass

    await asyncio.gather(ws_to_tcp(), tcp_to_ws(), return_exceptions=True)


async def proxy_connection(reader, writer, target_host, target_port, initial_data=b""):
    try:
        target_reader, target_writer = await asyncio.open_connection(target_host, target_port)
    except Exception:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass
        return

    if initial_data:
        target_writer.write(initial_data)
        await target_writer.drain()

    async def pipe(src, dst):
        try:
            while True:
                data = await src.read(65536)
                if not data:
                    break
                dst.write(data)
                await dst.drain()
        except Exception:
            pass
        finally:
            try:
                dst.close()
                await dst.wait_closed()
            except Exception:
                pass

    await asyncio.gather(
        pipe(reader, target_writer),
        pipe(target_reader, writer),
        return_exceptions=True,
    )


async def detect_initial_data(reader):
    try:
        data = await asyncio.wait_for(reader.read(1), timeout=1.0)
    except asyncio.TimeoutError:
        return b""

    if not data:
        return b""

    if not data[:1].isalpha():
        return data

    while len(data) < 16 and any(method.startswith(data) for method in HTTP_METHODS):
        if any(data.startswith(method) for method in HTTP_METHODS):
            break
        try:
            more = await asyncio.wait_for(reader.read(1), timeout=0.2)
        except asyncio.TimeoutError:
            break
        if not more:
            break
        data += more

    return data


async def handle_tls_client(reader, writer):
    initial_data = await detect_initial_data(reader)
    if any(initial_data.startswith(method) for method in HTTP_METHODS):
        await proxy_connection(reader, writer, WS_LOCAL_HOST, WS_LOCAL_PORT, initial_data)
    else:
        await proxy_connection(reader, writer, SSH_HOST, SSH_PORT, initial_data)


async def main():
    stop_event = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, stop_event.set)

    ssl_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ssl_context.minimum_version = ssl.TLSVersion.TLSv1_2
    ssl_context.load_cert_chain(certfile=CERT_PATH, keyfile=KEY_PATH)

    ws_server = await serve(ws_bridge, WS_LOCAL_HOST, WS_LOCAL_PORT, max_size=None, ping_interval=None)
    tls_server = await asyncio.start_server(handle_tls_client, host=None, port=TLS_PORT, ssl=ssl_context)

    try:
        await stop_event.wait()
    finally:
        ws_server.close()
        await ws_server.wait_closed()
        tls_server.close()
        await tls_server.wait_closed()


if __name__ == "__main__":
    asyncio.run(main())
EOF_PY

