            },
            {
                "address": "localhost",
                "skipFallback": true
            }
        ],
        "queryStrategy": "UseIP"
    },
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
            {
                "type": "field",
                "domain": [
                    "geosite:category-ads-all"
                ],
                "outboundTag": "block"
            },
            {
                "type": "field",
                "ip": [
                    "geoip:private"
                ],
                "outboundTag": "block"
            }
        ]
    },
    "inbounds": [
        {
            "listen": "$ADDITIONAL_IP",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "id": "$NEW_UUID",
                        "flow": "xtls-rprx-vision"
                    }
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "$CAMOUFLAGE:443",
                    "xver": 0,
                    "serverNames": [
                        "$CAMOUFLAGE"
                    ],
                    "privateKey": "$PRIVATE_KEY",
                    "minClientVer": "",
                    "maxClientVer": "",
                    "maxTimeDiff": 0,
                    "shortIds": [
                        "$SHORT_ID"
                    ]
                },
                "sockopt": {
                    "tcpKeepAliveIdle": 60,
                    "tcpKeepAliveInterval": 30,
                    "tcpFastOpen": true,
                    "tcpNoDelay": true
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "routeOnly": true
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct",
            "settings": {
                "domainStrategy": "UseIPv4v6"
            },
            "streamSettings": {
                "sockopt": {
                    "tcpKeepAliveIdle": 60,
                    "tcpKeepAliveInterval": 30,
                    "tcpFastOpen": true,
                    "tcpNoDelay": true
                }
            }
        },
        {
            "protocol": "blackhole",
            "tag": "block"
        }
    ],
    "policy": {
        "levels": {
            "0": {
                "handshake": 8,
                "connIdle": 300,
                "uplinkOnly": 3,
                "downlinkOnly": 5,
                "bufferSize": 64
            }
        }
    }
}
EOF

    print_success "Configuration created"

    # Create systemd service
    print_info "Creating systemd service..."

    cat > "/etc/systemd/system/$SERVICE_NAME.service" << EOF
