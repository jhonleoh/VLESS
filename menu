        local ssh_ws_port=$(grep '^SSH_WS_PORT=' /usr/local/etc/ssh-ws/config.env 2>/dev/null | cut -d= -f2-)
        local ssh_ws_path=$(grep '^SSH_WS_PATH=' /usr/local/etc/ssh-ws/config.env 2>/dev/null | cut -d= -f2-)
        local ssh_ws_bind=""
        if [[ -n "$ssh_ws_port" ]]; then
            ssh_ws_bind=$(ss -tln | awk -v port=":$ssh_ws_port" '$4 ~ port"$" {print $4; exit}')
        fi
        if echo "$ssh_ws_bind" | grep -q '^\*:' || echo "$ssh_ws_bind" | grep -q '^\[::\]:'; then
            echo -e "${GREEN}[✓]${NC} SSH WebSocket: Running on port ${ssh_ws_port:-configured} ${ssh_ws_path:+(path $ssh_ws_path)} (IPv4+IPv6)"
