show_menu() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   VPN Gaming Autoscript v$SCRIPT_VERSION        ║${NC}"
    echo -e "${GREEN}║   Optimized for Low-Ping Gaming        ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}1.${NC} Install Trojan-GFW"
    echo -e "${CYAN}2.${NC} Install Xray (VLESS + XTLS-Reality)"
    echo -e "${CYAN}3.${NC} Add Trojan on Additional IP"
    echo -e "${CYAN}4.${NC} Add Xray on Additional IP"
    echo -e "${CYAN}5.${NC} Switch Protocol (Trojan ↔ Xray)"
    echo -e "${CYAN}6.${NC} View Connection Info"
    echo -e "${CYAN}7.${NC} Optimize for Gaming (BBR + Tweaks)"
    echo -e "${CYAN}8.${NC} Uninstall"
    echo -e "${CYAN}9.${NC} Exit"
    echo ""
    
    # Show service status
    if systemctl is-active --quiet trojan; then
        echo -e "${GREEN}[✓]${NC} Trojan: Running"
    fi
    if systemctl is-active --quiet xray; then
        echo -e "${GREEN}[✓]${NC} Xray: Running"
    fi
    
    # Count additional instances
    TROJAN_COUNT=0
    for service in /etc/systemd/system/trojan-*.service; do
        if [[ -f "$service" ]] && systemctl is-active --quiet "$(basename "$service" .service)"; then
            ((TROJAN_COUNT++))
        fi
    done
    if [[ $TROJAN_COUNT -gt 0 ]]; then
        echo -e "${GREEN}[✓]${NC} Trojan Additional IPs: $TROJAN_COUNT"
    fi
    
    XRAY_COUNT=0
    for service in /etc/systemd/system/xray-*.service; do
        if [[ -f "$service" ]] && systemctl is-active --quiet "$(basename "$service" .service)"; then
            ((XRAY_COUNT++))
        fi
    done
    if [[ $XRAY_COUNT -gt 0 ]]; then
        echo -e "${GREEN}[✓]${NC} Xray Additional IPs: $XRAY_COUNT"
    fi
    
    echo ""
}

main() {
    # Initial setup
    mkdir -p "$INSTALL_DIR"
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$CLIENT_DIR"
    touch "$LOG_FILE"
    
    # Check requirements
    check_root
    check_os
    check_internet
    
    # Main loop
    while true; do
        show_menu
        print_prompt "Enter your choice (1-9):"
        read -r CHOICE
        
        case $CHOICE in
            1) install_trojan ;;
            2) install_xray ;;
            3) add_trojan_on_ip ;;
            4) add_xray_on_ip ;;
            5) switch_protocol ;;
            6) view_connection_info ;;
            7) optimize_for_gaming ;;
            8) uninstall_vpn ;;
            9)
                clear
                print_success "Thank you for using VPN Gaming Autoscript!"
                exit 0
                ;;
            *)
                print_error "Invalid choice. Please try again."
                sleep 2
                ;;
        esac
    done
}

# Run main function
main
