###############################################################################
# Speed Test Module (IPv4 vs IPv6 Comparison)
###############################################################################

speed_test() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Network Speed & Latency Test                ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # IPv4 latency test
    echo -e "${CYAN}=== IPv4 Latency Test ===${NC}"
    if ping -4 -c 5 -W 3 8.8.8.8 &> /dev/null; then
        local ipv4_ping=$(ping -4 -c 5 -W 3 8.8.8.8 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Google DNS (8.8.8.8): ${GREEN}${ipv4_ping}ms${NC}"
    else
        echo -e "  Google DNS (8.8.8.8): ${RED}Unreachable${NC}"
    fi

    if ping -4 -c 5 -W 3 1.1.1.1 &> /dev/null; then
        local ipv4_cf=$(ping -4 -c 5 -W 3 1.1.1.1 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Cloudflare (1.1.1.1): ${GREEN}${ipv4_cf}ms${NC}"
    else
        echo -e "  Cloudflare (1.1.1.1): ${RED}Unreachable${NC}"
    fi
    echo ""

    # IPv6 latency test
    echo -e "${CYAN}=== IPv6 Latency Test ===${NC}"
    if ping -6 -c 5 -W 3 2001:4860:4860::8888 &> /dev/null; then
        local ipv6_ping=$(ping -6 -c 5 -W 3 2001:4860:4860::8888 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Google DNS (2001:4860:4860::8888): ${GREEN}${ipv6_ping}ms${NC}"
    else
        echo -e "  Google DNS (2001:4860:4860::8888): ${YELLOW}Not available${NC}"
    fi

    if ping -6 -c 5 -W 3 2606:4700:4700::1111 &> /dev/null; then
        local ipv6_cf=$(ping -6 -c 5 -W 3 2606:4700:4700::1111 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        echo -e "  Cloudflare (2606:4700:4700::1111): ${GREEN}${ipv6_cf}ms${NC}"
    else
        echo -e "  Cloudflare (2606:4700:4700::1111): ${YELLOW}Not available${NC}"
    fi
    echo ""

    # Download speed test (if curl supports it)
    echo -e "${CYAN}=== Download Speed Test ===${NC}"
    print_info "Testing IPv4 download speed..."
    local ipv4_speed=$(curl -4 -s -o /dev/null -w '%{speed_download}' --connect-timeout 10 --max-time 15 http://speedtest.tele2.net/1MB.zip 2>/dev/null)
    if [[ -n "$ipv4_speed" ]] && [[ "$ipv4_speed" != "0.000" ]]; then
        local ipv4_mbps=$(echo "scale=2; $ipv4_speed / 1048576" | bc 2>/dev/null)
        echo -e "  IPv4 Download: ${GREEN}${ipv4_mbps} MB/s${NC}"
    else
        echo -e "  IPv4 Download: ${RED}Failed${NC}"
    fi

    print_info "Testing IPv6 download speed..."
    local ipv6_speed=$(curl -6 -s -o /dev/null -w '%{speed_download}' --connect-timeout 10 --max-time 15 http://speedtest.tele2.net/1MB.zip 2>/dev/null)
    if [[ -n "$ipv6_speed" ]] && [[ "$ipv6_speed" != "0.000" ]]; then
        local ipv6_mbps=$(echo "scale=2; $ipv6_speed / 1048576" | bc 2>/dev/null)
        echo -e "  IPv6 Download: ${GREEN}${ipv6_mbps} MB/s${NC}"
    else
        echo -e "  IPv6 Download: ${YELLOW}Not available or failed${NC}"
    fi
    echo ""

    # System optimization status
    echo -e "${CYAN}=== Optimization Status ===${NC}"
    if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr; then
        echo -e "  BBR Congestion Control: ${GREEN}Enabled${NC}"
    else
        echo -e "  BBR Congestion Control: ${RED}Disabled${NC}"
    fi

    if sysctl net.ipv4.tcp_fastopen 2>/dev/null | grep -q 3; then
        echo -e "  TCP Fast Open: ${GREEN}Enabled (client+server)${NC}"
    else
        echo -e "  TCP Fast Open: ${YELLOW}Partial or disabled${NC}"
    fi

    local cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    echo -e "  Congestion Algorithm: ${CYAN}$cc${NC}"

    local qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null)
    echo -e "  Queue Discipline: ${CYAN}$qdisc${NC}"

    if sysctl net.ipv6.conf.all.forwarding 2>/dev/null | grep -q 1; then
        echo -e "  IPv6 Forwarding: ${GREEN}Enabled${NC}"
    else
        echo -e "  IPv6 Forwarding: ${RED}Disabled${NC}"
    fi

    local nofile=$(ulimit -n 2>/dev/null)
    echo -e "  File Descriptors Limit: ${CYAN}$nofile${NC}"

    echo ""
    read -p "Press Enter to continue..."
}

