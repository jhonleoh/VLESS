###############################################################################
# Trojan on Additional IP (Dual-Stack)
###############################################################################

add_trojan_on_ip() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Add Trojan on Additional IP (Dual-Stack)    ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Check if main Trojan is installed
    if ! systemctl is-active --quiet trojan; then
        print_error "Main Trojan service is not installed"
        print_info "Please install Trojan first (option 1)"
        read -p "Press Enter to continue..."
        return 1
    fi

    # Show available IPs (IPv4 + IPv6)
    print_info "Detecting server IP addresses (IPv4 + IPv6)..."
    echo ""
    mapfile -t IPV4S < <(get_all_ips)
    mapfile -t IPV6S < <(get_all_ipv6)

    local ALL_IPS=()
    local idx=1

    echo -e "${CYAN}Available IPv4 addresses:${NC}"
    for ip in "${IPV4S[@]}"; do
        echo "  $idx. $ip"
        ALL_IPS+=("$ip")
        ((idx++))
    done

    if [[ ${#IPV6S[@]} -gt 0 ]]; then
        echo ""
        echo -e "${CYAN}Available IPv6 addresses:${NC}"
        for ip in "${IPV6S[@]}"; do
            echo "  $idx. $ip"
            ALL_IPS+=("$ip")
            ((idx++))
        done
    fi

    echo "  $idx. Enter custom IP (IPv4 or IPv6)"
    echo ""

    print_prompt "Select IP address (1-$idx):"
    read -r IP_CHOICE

    if [[ $IP_CHOICE -eq $idx ]]; then
        print_prompt "Enter IP address (IPv4 or IPv6):"
        read -r ADDITIONAL_IP
    elif [[ $IP_CHOICE -ge 1 ]] && [[ $IP_CHOICE -lt $idx ]]; then
        ADDITIONAL_IP="${ALL_IPS[$((IP_CHOICE-1))]}"
    else
        print_error "Invalid choice"
        read -p "Press Enter to continue..."
        return 1
    fi

    print_info "Using IP: $ADDITIONAL_IP"

    # Generate unique identifier for this instance
    IP_SUFFIX=$(format_ip_suffix "$ADDITIONAL_IP")
    SERVICE_NAME="trojan-$IP_SUFFIX"
    CONFIG_FILE="/usr/local/etc/trojan/config-$IP_SUFFIX.json"

    # Check if already exists
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        print_warning "Trojan is already running on $ADDITIONAL_IP"
        read -p "Press Enter to continue..."
        return 0
    fi

    # Generate new password
    NEW_PASSWORD=$(generate_random_password)

    # Copy and modify configuration
    print_info "Creating configuration for $ADDITIONAL_IP..."

    # Check if using certificates or self-signed
    if [[ -f "/usr/local/etc/trojan/config.json" ]]; then
        # Copy base config and modify
        cp /usr/local/etc/trojan/config.json "$CONFIG_FILE"

        # Update local_addr to bind to specific IP
        local bind_addr="$ADDITIONAL_IP"
        jq --arg ip "$bind_addr" '.local_addr = $ip' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

        # Update password
        jq --arg pass "$NEW_PASSWORD" '.password = [$pass]' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

        print_success "Configuration created"
    else
        print_error "Base configuration not found"
        return 1
    fi

    # Create systemd service
    print_info "Creating systemd service..."

    cat > "/etc/systemd/system/$SERVICE_NAME.service" << EOF
[Unit]
Description=Trojan-GFW Server on $ADDITIONAL_IP (Dual-Stack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/trojan -c $CONFIG_FILE
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable "$SERVICE_NAME" > /dev/null 2>&1
    systemctl start "$SERVICE_NAME"

    if systemctl is-active --quiet "$SERVICE_NAME"; then
        print_success "Trojan service started on $ADDITIONAL_IP"
    else
        print_error "Failed to start Trojan service"
        journalctl -u "$SERVICE_NAME" -n 20
        read -p "Press Enter to continue..."
        return 1
    fi

    # Save credentials
    local URL_HOST=$(format_ip_for_url "$ADDITIONAL_IP")
    cat > "$CLIENT_DIR/trojan-$IP_SUFFIX-credentials.txt" << EOF
Trojan-GFW Server Information (Dual-Stack)
============================================
Server: $ADDITIONAL_IP
Port: 443
Password: $NEW_PASSWORD
SNI: $ADDITIONAL_IP
Allow Insecure: true

Connection URI:
trojan://$NEW_PASSWORD@$URL_HOST:443#Trojan-$IP_SUFFIX
EOF

    # Generate QR code
    qrencode -t ANSIUTF8 "trojan://$NEW_PASSWORD@$URL_HOST:443#Trojan-$IP_SUFFIX" > "$CLIENT_DIR/trojan-$IP_SUFFIX-qr.txt" 2>/dev/null

    # Display information
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Trojan Added on Additional IP! (Dual-Stack) ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${CYAN}Server:${NC} $ADDITIONAL_IP"
    echo -e "${CYAN}Port:${NC} 443"
    echo -e "${CYAN}Password:${NC} $NEW_PASSWORD"
    echo ""
    echo -e "${YELLOW}Connection URI:${NC}"
    echo "trojan://$NEW_PASSWORD@$URL_HOST:443#Trojan-$IP_SUFFIX"
    echo ""
    if [[ -f "$CLIENT_DIR/trojan-$IP_SUFFIX-qr.txt" ]]; then
        cat "$CLIENT_DIR/trojan-$IP_SUFFIX-qr.txt"
    fi
    echo ""
    print_info "Credentials saved to: $CLIENT_DIR/trojan-$IP_SUFFIX-credentials.txt"
    echo ""
    read -p "Press Enter to continue..."
}

