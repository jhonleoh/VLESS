            xray_ws_bind=$(ss -tlnp | grep xray | awk '{print $4}' | head -1)
        fi
        if echo "$xray_ws_bind" | grep -q '^\*:' || echo "$xray_ws_bind" | grep -q '^\[::\]:'; then
            echo -e "${GREEN}[✓]${NC} Xray WS+TLS: Running (IPv4+IPv6)"
        else
            echo -e "${GREEN}[✓]${NC} Xray WS+TLS: Running"
        fi
    fi
