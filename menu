add_xray_on_ip() {
    clear
    echo -e "${GREEN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   Add Xray on Additional IP (Dual-Stack)      ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"
    echo ""

    # Check if main Xray is installed
    if ! systemctl is-active --quiet xray; then
        print_error "Main Xray service is not installed"
        print_info "Please install Xray first (option 3)"
        read -p "Press Enter to continue..."
        return 1
    fi

    # Show available IPs (IPv4 + IPv6)
    print_info "Detecting server IP addresses (IPv4 + IPv6)..."
    echo ""
    mapfile -t IPV4S < <(get_all_ips)
    mapfile -t IPV6S < <(get_all_ipv6)

    local ALL_IPS=()
    local idx=1

    echo -e "${CYAN}Available IPv4 addresses:${NC}"
    for ip in "${IPV4S[@]}"; do
        echo "  $idx. $ip"
        ALL_IPS+=("$ip")
        ((idx++))
    done

    if [[ ${#IPV6S[@]} -gt 0 ]]; then
        echo ""
        echo -e "${CYAN}Available IPv6 addresses:${NC}"
        for ip in "${IPV6S[@]}"; do
            echo "  $idx. $ip"
            ALL_IPS+=("$ip")
            ((idx++))
        done
    fi

    echo "  $idx. Enter custom IP (IPv4 or IPv6)"
    echo ""

    print_prompt "Select IP address (1-$idx):"
    read -r IP_CHOICE

    if [[ $IP_CHOICE -eq $idx ]]; then
        print_prompt "Enter IP address (IPv4 or IPv6):"
        read -r ADDITIONAL_IP
    elif [[ $IP_CHOICE -ge 1 ]] && [[ $IP_CHOICE -lt $idx ]]; then
        ADDITIONAL_IP="${ALL_IPS[$((IP_CHOICE-1))]}"
    else
        print_error "Invalid choice"
        read -p "Press Enter to continue..."
        return 1
    fi

    print_info "Using IP: $ADDITIONAL_IP"

    # Generate unique identifier for this instance
    IP_SUFFIX=$(format_ip_suffix "$ADDITIONAL_IP")
    SERVICE_NAME="xray-$IP_SUFFIX"
    CONFIG_FILE="/usr/local/etc/xray/config-$IP_SUFFIX.json"

    # Check if already exists
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        print_warning "Xray is already running on $ADDITIONAL_IP"
        read -p "Press Enter to continue..."
        return 0
    fi

    # Generate new parameters
    NEW_UUID=$(generate_uuid)

    # Generate X25519 keys
    KEYS=$(/usr/local/bin/xray x25519 2>&1)
    if [[ $? -ne 0 ]]; then
        print_error "Failed to generate X25519 keys"
        read -p "Press Enter to continue..."
        return 1
    fi

    PRIVATE_KEY=$(echo "$KEYS" | sed -nE 's/^[[:space:]]*Private[[:space:]]*[Kk]ey:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\1/p' | head -n1)
    PUBLIC_KEY=$(echo "$KEYS" | sed -nE 's/^[[:space:]]*(Password[[:space:]]*\()?[Pp]ublic[[:space:]]*[Kk]ey\)?:[[:space:]]*([^[:space:]]+)[[:space:]]*$/\2/p' | head -n1)
    SHORT_ID=$(generate_short_id 8)

    # Validate keys
    if [[ -z "$PRIVATE_KEY" ]] || [[ -z "$PUBLIC_KEY" ]]; then
        print_error "Failed to extract keys"
        print_info "Expected formats: 'Private key: <value>' or 'PrivateKey: <value>'"
        print_info "Expected formats: 'Public key: <value>', 'PublicKey: <value>', or 'Password (PublicKey): <value>'"
        print_info "Keys output: $KEYS"
        read -p "Press Enter to continue..."
        return 1
    fi

    # Get camouflage from main config
    CAMOUFLAGE=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' /usr/local/etc/xray/config.json)

    # Ensure firewall allows this IP
    if is_ipv6 "$ADDITIONAL_IP"; then
        ip6tables -C INPUT -d "$ADDITIONAL_IP" -p tcp --dport 443 -j ACCEPT 2>/dev/null || \
            ip6tables -A INPUT -d "$ADDITIONAL_IP" -p tcp --dport 443 -j ACCEPT
    fi

    print_info "Creating configuration for $ADDITIONAL_IP..."

    # Create new config (bind to specific IP, with keepalive sockopt)
    cat > "$CONFIG_FILE" << EOF
{
    "log": {
        "loglevel": "warning"
    },
    "dns": {
        "servers": [
            {
                "address": "https+local://1.1.1.1/dns-query",
