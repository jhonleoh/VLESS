        print_warning "Xray-core or the gRPC Reality service is already present"
        read -p "Do you want to reinstall the Xray REALITY + gRPC configuration? (y/n): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            return 0
        fi
    fi

    local xray_install_log="/tmp/xray-grpc-reality-install.log"
